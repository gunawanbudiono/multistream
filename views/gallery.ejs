function playMedia(mediaId, mediaTitle, mediaType) {
  const modal = document.getElementById('mediaPreviewModal');
  const title = document.getElementById('previewModalTitle');
  const typeIcon = document.getElementById('previewModalTypeIcon');
  const videoCont = document.getElementById('previewVideoContainer');
  const audioCont = document.getElementById('previewAudioContainer');
  const imageCont = document.getElementById('previewImageContainer');
  const video = document.getElementById('previewNativeVideo');
  const audio = document.getElementById('previewNativeAudio');
  const image = document.getElementById('previewNativeImage');
  const spinner = document.getElementById('previewVideoSpinner');

  if (!modal) return;

  title.textContent = mediaTitle || 'Media Preview';

  videoCont.classList.add('hidden');
  audioCont.classList.add('hidden');
  imageCont.classList.add('hidden');

  const streamUrl = `/stream/${encodeURIComponent(mediaId)}`;

  if (mediaType === 'audio') {
    typeIcon.className = 'w-9 h-9 rounded-xl bg-purple-500/20 flex items-center justify-center shrink-0 text-purple-400';
    typeIcon.innerHTML = '<i class="ti ti-music text-lg"></i>';
    audioCont.classList.remove('hidden');
    audio.src = streamUrl;
    audio.play().catch(() => {});
  } else if (mediaType === 'image') {
    typeIcon.className = 'w-9 h-9 rounded-xl bg-green-500/20 flex items-center justify-center shrink-0 text-green-400';
    typeIcon.innerHTML = '<i class="ti ti-photo text-lg"></i>';
    imageCont.classList.remove('hidden');
    image.src = streamUrl;
  } else {
    typeIcon.className = 'w-9 h-9 rounded-xl bg-blue-500/20 flex items-center justify-center shrink-0 text-blue-400';
    typeIcon.innerHTML = '<i class="ti ti-video text-lg"></i>';
    videoCont.classList.remove('hidden');
    
    if (spinner) spinner.classList.remove('opacity-0', 'pointer-events-none');
    video.src = streamUrl;
    
    const hideSpinner = () => {
      if (spinner) spinner.classList.add('opacity-0', 'pointer-events-none');
    };
    
    video.onplaying = hideSpinner;
    video.oncanplay = hideSpinner;
    video.onloadeddata = hideSpinner;
    video.ontimeupdate = hideSpinner;
    video.onwaiting = () => {
      if (spinner) spinner.classList.remove('opacity-0', 'pointer-events-none');
    };

    video.play().catch((err) => {
      console.warn('Autoplay with audio blocked by browser policy:', err);
    });
  }

  modal.classList.remove('hidden');
  document.body.classList.add('overflow-hidden');
}

function closePreviewModal() {
  const modal = document.getElementById('mediaPreviewModal');
  const video = document.getElementById('previewNativeVideo');
  const audio = document.getElementById('previewNativeAudio');
  const image = document.getElementById('previewNativeImage');

  if (video) {
    video.pause();
    video.removeAttribute('src');
    video.load(); // Immediately aborts network HTTP stream
  }
  if (audio) {
    audio.pause();
    audio.removeAttribute('src');
    audio.load();
  }
  if (image) {
    image.removeAttribute('src');
  }

  if (modal) modal.classList.add('hidden');
  document.body.classList.remove('overflow-hidden');
}

