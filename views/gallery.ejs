  function buildVideoGridMarkup(video) {
    const mediaType = detectItemCategory(video);
    const thumbnail = escapeHtml(video.thumbnail_path || video.filepath || '/images/default-video-thumbnail.svg');
    const title = escapeHtml(video.title || '');
    const isPortrait = video.resolution && (function() {
      const parts = (video.resolution || '').split('x');
      return parts.length === 2 && parseInt(parts[1]) > parseInt(parts[0]);
    })();

    let mediaContent = '';
    if (mediaType === 'audio') {
      mediaContent = `
        <div class="w-full h-full flex items-center justify-center bg-[#181818]">
          <div class="w-16 h-16 rounded-full bg-primary/20 flex items-center justify-center audio-visualizer">
            <i class="ti ti-music text-3xl text-primary"></i>
          </div>
        </div>
      `;
    } else if (isPortrait) {
      mediaContent = `
        <img src="${thumbnail}" alt="" class="absolute inset-0 w-full h-full object-cover blur-xl opacity-35 scale-125" loading="lazy" decoding="async">
        <img src="${thumbnail}" alt="${title}" class="h-full w-auto max-w-full object-contain relative z-10 mx-auto drop-shadow-md" loading="lazy" decoding="async">
