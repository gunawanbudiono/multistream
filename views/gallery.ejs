function cleanClientYouTubeUrl(raw) {
  if (!raw) return '';
  try {
    const trimmed = raw.trim();
    if (trimmed.includes('youtube.com') || trimmed.includes('youtu.be')) {
      const parsed = new URL(trimmed);
      const v = parsed.searchParams.get('v');
      if (v) return `https://www.youtube.com/watch?v=${v}`;
      if (parsed.pathname.startsWith('/shorts/')) {
        const id = parsed.pathname.split('/shorts/')[1]?.split('?')[0]?.split('/')[0];
        if (id) return `https://www.youtube.com/watch?v=${id}`;
      }
      if (parsed.hostname === 'youtu.be') {
        const id = parsed.pathname.replace(/^\//, '').split('?')[0];
        if (id) return `https://www.youtube.com/watch?v=${id}`;
      }
    }
    return trimmed;
  } catch (e) {
    return raw.trim();
  }
}

async function handlePasteAndScan() {
  const input = document.getElementById('ytUrlInput');
  if (!input) return;

  // If input already has text, scan directly
  if (input.value && input.value.trim().length > 5) {
    return handleScanYouTubeUrl();
  }

  // Attempt to read from clipboard
  if (navigator.clipboard && navigator.clipboard.readText) {
    try {
      const clipText = await navigator.clipboard.readText();
      if (clipText && (clipText.includes('youtube.com') || clipText.includes('youtu.be'))) {
        input.value = clipText.trim();
        return handleScanYouTubeUrl();
      } else if (clipText && clipText.trim()) {
        input.value = clipText.trim();
      }
    } catch (err) {
      console.log('Clipboard access denied or unavailable:', err);
    }
  }

  handleScanYouTubeUrl();
}

async function handleScanYouTubeUrl() {
  const input = document.getElementById('ytUrlInput');
  const url = cleanClientYouTubeUrl(input?.value);
  if (!url) {
    showToast('error', 'Please enter or paste a valid YouTube URL');
    return;
  }

  if (!url.includes('youtube.com') && !url.includes('youtu.be')) {
    showToast('error', 'Please enter a valid YouTube or Shorts link');
    return;
  }

  if (ytDownloadQueue.some(item => item.url === url)) {
    showToast('error', 'This video is already in the queue');
    input.value = '';
    return;
  }

  const scanBtn = document.getElementById('ytScanBtn');
  const scanIcon = document.getElementById('ytScanIcon');
  const scanText = document.getElementById('ytScanText');

  scanBtn.disabled = true;
  scanIcon.className = 'ti ti-loader-2 text-base animate-spin';
  scanText.textContent = 'Scanning...';

  try {
    const res = await fetch('/api/youtube/inspect', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url })
    });
    const data = await res.json();

    if (!data.success || !data.metadata) {
      throw new Error(data.error || 'Failed to scan YouTube video');
    }

    const meta = data.metadata;
    ytDownloadQueue.push({
      id: meta.id,
      title: meta.title,
      channel: meta.channel,
      duration: meta.duration,
      durationFormatted: meta.durationFormatted,
      thumbnail: meta.thumbnail,
      url: meta.url || url,
      resolutions: meta.resolutions || [],
      selectedResolution: meta.defaultResolution || (meta.resolutions[0]?.height || '1080'),
      alreadyInGallery: meta.alreadyInGallery || null
    });

    input.value = '';
    renderYtQueue();
    if (meta.alreadyInGallery && meta.alreadyInGallery.exists) {
      showToast('info', `Note: "${meta.title.slice(0, 25)}..." is already in your Gallery (${meta.alreadyInGallery.resolution})`);
    } else {
      showToast('success', `Added "${meta.title.slice(0, 30)}..." to queue`);
    }

    // Check if YouTube SABR downgraded formats to 360p
    const maxVideoHeight = Math.max(...(meta.resolutions || []).filter(r => typeof r.height === 'number').map(r => r.height), 0);
    const banner = document.getElementById('ytCookieAlertBanner');
    if (maxVideoHeight > 0 && maxVideoHeight <= 360) {
      if (banner) {
        banner.classList.remove('hidden');
        const titleEl = document.getElementById('ytCookieBannerTitle');
        const descEl = document.getElementById('ytCookieBannerDesc');
        if (titleEl) titleEl.textContent = 'YouTube SABR Stream Detected (360p Cap)';
        if (descEl) descEl.textContent = 'YouTube restricted this video to 360p. Update cookies via Incognito robots.txt method to unlock Full HD (1080p/4K).';
      }
    } else {
      if (banner) banner.classList.add('hidden');
    }
  } catch (error) {
    console.error('YouTube scan error:', error);
    const msg = error.message || 'Failed to scan video';
    showToast('error', msg);
    const banner = document.getElementById('ytCookieAlertBanner');
    if (banner) {
      banner.classList.remove('hidden');
      const titleEl = document.getElementById('ytCookieBannerTitle');
      const descEl = document.getElementById('ytCookieBannerDesc');
      if (titleEl) titleEl.textContent = 'YouTube Authentication / Bot Check Required';
      if (descEl) descEl.textContent = 'Google requires fresh session cookies to scan this video. Please update cookies via Incognito robots.txt.';
    }
  } finally {
    scanBtn.disabled = false;
    scanIcon.className = 'ti ti-clipboard text-base';
    scanText.textContent = 'Paste';
  }
}

function formatClientBytes(bytes) {
  if (!bytes || bytes <= 0 || isNaN(bytes)) return '';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
}

function renderYtQueue() {
  const queueCount = document.getElementById('ytQueueCount');
  const emptyState = document.getElementById('ytQueueEmpty');
  const cardsContainer = document.getElementById('ytQueueCards');
  const submitBtn = document.getElementById('ytDownloadSubmitBtn');
  const submitText = document.getElementById('ytDownloadSubmitText');

  if (queueCount) queueCount.textContent = ytDownloadQueue.length;

  if (ytDownloadQueue.length === 0) {
    emptyState?.classList.remove('hidden');
    if (cardsContainer) cardsContainer.innerHTML = '';
    if (submitBtn) submitBtn.disabled = true;
    if (submitText) submitText.textContent = 'Start Download (0)';
    return;
  }

  emptyState?.classList.add('hidden');
  if (submitBtn) submitBtn.disabled = (ytActiveJobId !== null);

  // Calculate total batch size from all selected resolutions
  let totalBatchBytes = 0;
  ytDownloadQueue.forEach(item => {
    const res = (item.resolutions || []).find(r => String(r.height) === String(item.selectedResolution));
    if (res && res.filesize) totalBatchBytes += res.filesize;
  });
  const batchSizeStr = totalBatchBytes > 0 ? ` • ~${formatClientBytes(totalBatchBytes)}` : '';
  const countLabel = ytDownloadQueue.length === 1 ? '1 item' : `${ytDownloadQueue.length} items`;
  if (submitText) submitText.textContent = `Start Download (${countLabel}${batchSizeStr})`;

  if (cardsContainer) {
    cardsContainer.innerHTML = ytDownloadQueue.map((item, idx) => {
      const resOptionsHtml = item.resolutions.map(r => {
        const val = r.height === 'audio' || r.height === 0 ? 'audio' : r.height;
        const isSelected = String(item.selectedResolution) === String(val) ? 'selected' : '';
        return `<option value="${val}" ${isSelected}>${r.label}</option>`;
      }).join('');

      const duplicateBadgeHtml = item.alreadyInGallery && item.alreadyInGallery.exists
        ? `<div class="mb-1.5 inline-flex items-center gap-1 text-[10px] text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded-md font-medium">
             <i class="ti ti-alert-triangle text-xs shrink-0"></i>
             <span>Already in Gallery (${item.alreadyInGallery.resolution || 'Saved'})</span>
           </div>`
        : '';

      return `
        <div class="bg-dark-900 border border-gray-700/70 hover:border-gray-600 rounded-xl p-3 flex items-center gap-3 transition-all">
          <div class="relative w-24 h-14 rounded-lg overflow-hidden bg-black shrink-0 border border-gray-800">
            ${item.thumbnail ? `<img src="${item.thumbnail}" alt="" class="w-full h-full object-cover" loading="lazy">` : `<div class="w-full h-full flex items-center justify-center text-gray-600"><i class="ti ti-video text-xl"></i></div>`}
            <span class="absolute bottom-1 right-1 bg-black/80 text-[10px] text-white px-1 py-0.5 rounded font-mono font-medium">${item.durationFormatted}</span>
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-xs font-semibold text-white truncate mb-0.5" title="${item.title}">${item.title}</h4>
            <div class="text-[11px] text-gray-400 truncate mb-1 flex items-center gap-1.5">
              <span>${item.channel}</span>
            </div>
            ${duplicateBadgeHtml}
            <div class="flex items-center gap-2">
              <label class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Quality:</label>
              <select onchange="updateYtQueueResolution(${idx}, this.value)" class="bg-dark-800 border border-gray-700 text-gray-200 text-xs rounded-lg px-2 py-1 focus:outline-none focus:border-red-500 transition-colors max-w-[240px] truncate">
                ${resOptionsHtml}
              </select>
            </div>
          </div>
          <button type="button" onclick="removeYtQueueItem(${idx})" class="text-gray-500 hover:text-red-400 p-2 rounded-lg hover:bg-dark-800 transition-colors shrink-0" title="Remove from queue" ${ytActiveJobId ? 'disabled' : ''}>
            <i class="ti ti-trash text-base"></i>
          </button>
        </div>
      `;
    }).join('');
  }
}

function updateYtQueueResolution(index, value) {
  if (ytDownloadQueue[index]) {
    ytDownloadQueue[index].selectedResolution = value;
    renderYtQueue();
  }
}

function removeYtQueueItem(index) {
  if (ytActiveJobId) return;
  ytDownloadQueue.splice(index, 1);
  renderYtQueue();
}

async function startYtDownloadQueue() {
  if (ytDownloadQueue.length === 0 || ytActiveJobId) return;

  const submitBtn = document.getElementById('ytDownloadSubmitBtn');
  const progressContainer = document.getElementById('ytProgressContainer');
  const progressItemTitle = document.getElementById('ytProgressItemTitle');
  const progressBar = document.getElementById('ytProgressBar');
  const progressPercentage = document.getElementById('ytProgressPercentage');
  const progressMetrics = document.getElementById('ytProgressMetrics');
  const progressEta = document.getElementById('ytProgressEta');

  submitBtn.disabled = true;
  progressContainer.classList.remove('hidden');

  const items = ytDownloadQueue.map(item => {
    const selectedRes = (item.resolutions || []).find(r => String(r.height) === String(item.selectedResolution));
    return {
      url: item.url,
      title: item.title,
      duration: item.duration,
      resolution: item.selectedResolution,
      filesize: selectedRes?.filesize || 0,
      filesizeFormatted: selectedRes?.filesizeFormatted || ''
    };
  });

  try {
    const res = await fetch('/api/youtube/download', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items,
        folderId: currentFolderId || ''
      })
    });
    const data = await res.json();

    if (!data.success || !data.jobId) {
      throw new Error(data.error || 'Failed to start download');
    }

    ytActiveJobId = data.jobId;
    renderYtQueue();

    if (ytPollInterval) clearInterval(ytPollInterval);
    ytPollInterval = setInterval(async () => {
      if (!ytActiveJobId) {
        clearInterval(ytPollInterval);
        return;
      }

      try {
        const sRes = await fetch(`/api/youtube/status/${ytActiveJobId}`);
        const sData = await sRes.json();

        if (!sData.success || !sData.status) return;
        const job = sData.status;

        if (progressItemTitle) {
          progressItemTitle.textContent = `(${job.currentIndex + 1}/${job.totalItems}) ${job.currentItemTitle}`;
        }
        if (progressBar) progressBar.style.width = `${job.progress}%`;
        if (progressMetrics) {
          let metricsHtml = '';
          if (job.sizeProgress) {
            metricsHtml += `<span class="inline-flex items-center gap-1 text-gray-300"><i class="ti ti-file-download text-blue-400"></i> Size: <strong class="text-white">${job.sizeProgress}</strong></span>`;
          }
          if (job.speed) {
            if (metricsHtml) metricsHtml += `<span class="text-gray-600">•</span>`;
            metricsHtml += `<span class="inline-flex items-center gap-1 text-gray-300"><i class="ti ti-bolt text-red-400"></i> Speed: <strong class="text-white">${job.speed}</strong></span>`;
          }
          progressMetrics.innerHTML = metricsHtml || '<span class="inline-flex items-center gap-1"><i class="ti ti-loader-2 text-xs animate-spin text-red-400"></i> Downloading stream chunks...</span>';
        }
        if (progressEta) {
          progressEta.innerHTML = job.eta 
            ? `<span class="inline-flex items-center gap-1 text-gray-300"><i class="ti ti-clock text-amber-400"></i> ETA: <strong class="text-white">${job.eta}</strong></span>` 
            : '';
        }

        if (job.status === 'completed') {
          clearInterval(ytPollInterval);
          ytActiveJobId = null;
          showToast('success', `Successfully downloaded ${job.filesCount} YouTube video(s) to Gallery!`);
          ytDownloadQueue = [];
          renderYtQueue();
          progressContainer.classList.add('hidden');
          closeYouTubeDownloadModal();
          if (typeof loadDiskUsage === 'function') loadDiskUsage();
          if (typeof window.refreshGalleryData === 'function') await window.refreshGalleryData();
          else window.location.reload();
        } else if (job.status === 'failed') {
          clearInterval(ytPollInterval);
          ytActiveJobId = null;
          renderYtQueue();
          showToast('error', `Download failed: ${job.error || 'Unknown error'}`);
          submitBtn.disabled = false;
        }
      } catch (err) {
        console.error('YouTube poll error:', err);
      }
    }, 800);
  } catch (error) {
    console.error('YouTube download start error:', error);
    showToast('error', error.message || 'Failed to start download');
    submitBtn.disabled = false;
  }
}

function makeModalDismissible(modal, closeCallback) {
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeCallback();
  });
  const onKey = (e) => {
    if (e.key === 'Escape') {
      document.removeEventListener('keydown', onKey);
      closeCallback();
    }
  };
  document.addEventListener('keydown', onKey);
}

