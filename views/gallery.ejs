        `;

        div.querySelector('.file-cancel-btn').onclick = (e) => {
          e.stopPropagation();
          cancelledIndexes.add(idx);
          const st = div.querySelector('.file-status');
          const sub = div.querySelector('.file-substatus');
          if (st) { st.textContent = 'Cancelled'; st.className = 'file-status text-xs text-gray-500 font-semibold'; }
          if (sub) { sub.textContent = 'Skipped by user'; }
          div.querySelector('.file-cancel-btn')?.remove();
        };

        uploadFilesList.appendChild(div);
      });

      updateBatchMetrics(0, selectedFiles[0].name);

      const runUploadSingle = async (i) => {
        if (uploadAborted) return false;
        const file = selectedFiles[i];
        
        const activeCancelBtn = document.querySelector(`#upload-queue-item-${i} .file-cancel-btn`);
        if (activeCancelBtn) activeCancelBtn.remove();

        uploadProgressStatus.textContent = `Uploading (${i + 1}/${selectedFiles.length}): ${file.name}`;
        updateFileProgress(i, 'uploading', 0, 0, file.size);
        
        let result;
        if (file.size > 50 * 1024 * 1024) {
          result = await uploadChunked(file, i, selectedFiles.length);
        } else {
          result = await uploadUniversalSingle(file, i, selectedFiles.length);
        }
        
        if (result && result.success) {
          fileSuccessSet.add(i);
          fileLoadedBytesMap.set(i, file.size);
          updateFileProgress(i, 'success', 100, file.size, file.size);
        } else {
          fileSuccessSet.delete(i);
          updateFileProgress(i, 'error', 0, 0, file.size);
        }
        updateBatchMetrics(i, file.name);
        return result && result.success;
      };

      for (let i = 0; i < selectedFiles.length; i++) {
        if (uploadAborted) break;
        if (cancelledIndexes.has(i)) continue;
        await runUploadSingle(i);
      }

      const renderCompletionState = async () => {
        isUploadInProgress = false;
        await window.refreshGalleryData?.();
        loadDiskUsage();

        if (uploadAborted) return;

        const failedIndices = [];
        selectedFiles.forEach((_, idx) => {
          if (!fileSuccessSet.has(idx) && !cancelledIndexes.has(idx)) {
            failedIndices.push(idx);
          }
        });

        const successCount = fileSuccessSet.size;

        if (failedIndices.length === 0) {
          uploadProgressStatus.innerHTML = `<span class="text-emerald-400 font-bold flex items-center gap-1.5"><i class="ti ti-circle-check text-base"></i> All files uploaded successfully (${successCount}/${selectedFiles.length})</span>`;
          showToast('success', `${successCount} file${successCount > 1 ? 's' : ''} uploaded successfully`);

          // Update floating widget
          const floatTitle = document.getElementById('floatingUploadTitle');
          if (floatTitle) floatTitle.innerHTML = `<span class="text-emerald-400 font-bold">✓ All ${successCount} files uploaded</span>`;
          const floatIcon = document.getElementById('floatingUploadIcon');
          if (floatIcon) { floatIcon.className = 'ti ti-check text-emerald-400 text-lg'; }
          setTimeout(() => { hideFloatingUploadWidget(); }, 5000);
        } else {
          uploadProgressStatus.innerHTML = `<span class="text-amber-400 font-bold flex items-center gap-1.5"><i class="ti ti-alert-triangle text-base"></i> Finished with issues (${successCount} succeeded, ${failedIndices.length} failed)</span>`;
          showToast('warning', `${successCount} uploaded, ${failedIndices.length} failed`);
        }

        const modalFooterAction = document.getElementById('modalFooterAction');
        if (modalFooterAction) {
          let retryAllBtn = '';
          if (failedIndices.length > 0) {
            retryAllBtn = `
              <button type="button" id="retryAllFailedBtn" class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white rounded-lg transition-colors text-sm font-medium shadow-md flex items-center gap-2">
                <i class="ti ti-reload text-base"></i>
                <span>Retry Failed (${failedIndices.length})</span>
              </button>
            `;
          }
          modalFooterAction.innerHTML = `
            ${retryAllBtn}
            <button type="button" onclick="closeUploadModal()" class="px-5 py-2 bg-primary hover:bg-blue-600 text-white rounded-lg transition-colors text-sm font-medium shadow-md flex items-center gap-2">
              <i class="ti ti-check text-base"></i>
              <span>Done</span>
            </button>
          `;

          const retryAll = document.getElementById('retryAllFailedBtn');
          if (retryAll) {
            retryAll.onclick = async () => {
              retryAll.disabled = true;
              retryAll.innerHTML = '<i class="ti ti-loader animate-spin text-base"></i> <span>Retrying...</span>';
              isUploadInProgress = true;
              uploadAborted = false;
              for (const idx of failedIndices) {
                if (uploadAborted) break;
                await runUploadSingle(idx);
              }
              await renderCompletionState();
            };
          }
        }
      };

      window._retryUploadSingle = async (idx) => {
        isUploadInProgress = true;
        uploadAborted = false;
        await runUploadSingle(idx);
        await renderCompletionState();
      };

      await renderCompletionState();
    };

    window._triggerUploadProcess = triggerUploadProcess;
    window._bindUploadButtonHandler = (btn) => {
      if (btn) btn.onclick = triggerUploadProcess;
    };
    const currentUploadBtn = document.getElementById('uploadButton');
    if (currentUploadBtn) {
      currentUploadBtn.onclick = triggerUploadProcess;
    }
    setUploadButtonState(selectedFiles.length > 0);

  function updateFileProgress(index, status, percent, loadedBytes, totalBytes) {
    const item = document.getElementById(`upload-queue-item-${index}`);
    if (item) {
      const el = item.querySelector('.file-status');
      const sub = item.querySelector('.file-substatus');
      const actionArea = item.querySelector('.file-action-area');
      if (status === 'uploading') {
        el.textContent = `${percent}%`;
        el.className = 'file-status text-xs text-primary font-bold';
        if (sub && loadedBytes !== undefined && totalBytes !== undefined) {
          sub.textContent = `${formatFileSize(loadedBytes)} / ${formatFileSize(totalBytes)} (${percent}%)`;
        }
        if (actionArea) {
          actionArea.innerHTML = `<span class="file-status text-xs text-primary font-bold">${percent}%</span>`;
        }
      } else if (status === 'success') {
        el.textContent = '✓ Done';
        el.className = 'file-status text-xs text-green-400 font-bold';
        if (sub && totalBytes) sub.textContent = `Completed (${formatFileSize(totalBytes)})`;
        if (actionArea) {
          actionArea.innerHTML = `<span class="file-status text-xs text-green-400 font-bold">✓ Done</span>`;
        }
      } else if (status === 'error') {
        el.textContent = '✗ Failed';
        el.className = 'file-status text-xs text-red-400 font-bold';
        if (sub) sub.textContent = 'Upload failed';
        if (actionArea) {
          actionArea.innerHTML = `
            <span class="file-status text-xs text-red-400 font-bold mr-1">✗ Failed</span>
            <button type="button" class="retry-single-btn text-xs bg-amber-500/20 hover:bg-amber-500/30 text-amber-400 border border-amber-500/30 px-2 py-0.5 rounded transition-colors flex items-center gap-1 font-semibold" onclick="window._retryUploadSingle(${index})" title="Retry upload">
              <i class="ti ti-reload text-xs"></i> Retry
            </button>
          `;
        }
      }
    }
  }

  async function uploadUniversalSingle(file, index, total) {
    if (uploadAborted) return { success: false };
    return new Promise((resolve) => {
      const formData = new FormData();
      formData.append('media', file);
      formData.append('folderId', document.getElementById('uploadFolderId').value || '');
      const xhr = new XMLHttpRequest();
      currentActiveXhr = xhr;
      xhr.timeout = 60 * 60 * 1000;
      xhr.upload.addEventListener('progress', (e) => {
        if (e.lengthComputable) {
          fileLoadedBytesMap.set(index, e.loaded);
          const pct = Math.round((e.loaded / e.total) * 100);
          updateFileProgress(index, 'uploading', pct, e.loaded, e.total);
          updateBatchMetrics(index, file.name);
        }
      });
      xhr.addEventListener('load', () => {
        currentActiveXhr = null;
        if (xhr.status === 200) {
          try {
            const r = JSON.parse(xhr.responseText);
            fileLoadedBytesMap.set(index, file.size);
            resolve({ success: r.success });
          } catch {
            resolve({ success: false });
          }
        } else {
          try {
            const errJson = JSON.parse(xhr.responseText);
            if (errJson.error) showToast('error', errJson.error);
          } catch (e) {}
          resolve({ success: false });
        }
      });
      xhr.addEventListener('error', () => { currentActiveXhr = null; resolve({ success: false }); });
      xhr.addEventListener('abort', () => { currentActiveXhr = null; resolve({ success: false }); });
      xhr.addEventListener('timeout', () => { currentActiveXhr = null; resolve({ success: false }); });
      xhr.open('POST', '/api/media/upload-universal', true);
      xhr.send(formData);
    });
  }

  async function uploadChunked(file, index, totalFiles) {
    if (uploadAborted) return { success: false };
    const chunkSize = 50 * 1024 * 1024;
    const totalChunks = Math.ceil(file.size / chunkSize);
    try {
      const init = await fetch('/api/videos/chunk/init', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          filename: file.name,
          fileSize: file.size,
          totalChunks,
          folderId: document.getElementById('uploadFolderId').value || ''
        })
      });
      const initData = await init.json();
      if (!initData.success) throw new Error(initData.error || 'Failed to initialize chunk upload');
      const uploadId = initData.uploadId;
      currentActiveUploadId = uploadId;
      let uploaded = new Set(initData.uploadedChunks || []);

      const chunkProgress = new Map();
      uploaded.forEach(c => chunkProgress.set(c, Math.min(chunkSize, file.size - c * chunkSize)));

      const uploadChunkSingle = async (chunkIndex) => {
        if (uploadAborted) return;
        if (uploaded.has(chunkIndex)) return;
        const start = chunkIndex * chunkSize;
        const end = Math.min(start + chunkSize, file.size);
        const chunk = file.slice(start, end);

        let retries = 4;
        let backoffMs = 1000;
        while (retries > 0) {
          if (uploadAborted) return;
          try {
            await new Promise((resolve, reject) => {
              const xhr = new XMLHttpRequest();
              currentActiveXhr = xhr;
              xhr.timeout = 15 * 60 * 1000;
              xhr.upload.addEventListener('progress', (e) => {
                if (e.lengthComputable) {
                  chunkProgress.set(chunkIndex, e.loaded);
                  let fileLoaded = 0;
                  chunkProgress.forEach(b => fileLoaded += b);
                  fileLoadedBytesMap.set(index, fileLoaded);
                  const pct = Math.round((fileLoaded / file.size) * 100);
                  updateFileProgress(index, 'uploading', pct, fileLoaded, file.size);
                  updateBatchMetrics(index, file.name);
                }
              });
              xhr.addEventListener('load', () => {
                currentActiveXhr = null;
                if (xhr.status === 200) {
                  chunkProgress.set(chunkIndex, chunk.size);
                  uploaded.add(chunkIndex);
                  resolve();
                } else {
                  reject(new Error(`Chunk ${chunkIndex} failed with status ${xhr.status}`));
                }
              });
              xhr.addEventListener('error', () => { currentActiveXhr = null; reject(new Error('Network error')); });
              xhr.addEventListener('abort', () => { currentActiveXhr = null; reject(new Error('Aborted')); });
              xhr.addEventListener('timeout', () => { currentActiveXhr = null; reject(new Error('Timeout')); });

              xhr.open('POST', '/api/videos/chunk/upload', true);
              xhr.setRequestHeader('Content-Type', 'application/octet-stream');
              xhr.setRequestHeader('X-Upload-Id', uploadId);
              xhr.setRequestHeader('X-Chunk-Index', chunkIndex.toString());
              xhr.send(chunk);
            });
            break;
          } catch (err) {
            retries--;
            if (retries === 0 || uploadAborted) throw err;
            await new Promise(r => setTimeout(r, backoffMs));
            backoffMs *= 1.5;
          }
        }
      };

      const workers = [];
      const concurrency = 3;
      let nextChunk = 0;

      for (let w = 0; w < concurrency; w++) {
        workers.push((async () => {
          while (nextChunk < totalChunks) {
            if (uploadAborted) break;
            const current = nextChunk++;
            await uploadChunkSingle(current);
          }
        })());
      }

      await Promise.all(workers);
      if (uploadAborted) return { success: false };

      const queueSub = document.querySelector(`#upload-queue-item-${index} .file-substatus`);
      if (queueSub) queueSub.textContent = 'Assembling chunks & generating thumbnail...';
      const floatSub = document.getElementById('floatingUploadSubtitle');
      if (floatSub) floatSub.textContent = '100% • Finalizing media on server...';

      const complete = await fetch('/api/videos/chunk/complete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ uploadId })
      });
      const completeData = await complete.json();
      currentActiveUploadId = null;
      if (!completeData.success) throw new Error(completeData.error || 'Failed to complete upload');

      return { success: true };
    } catch (error) {
      console.error('Chunked upload error:', error);
      currentActiveUploadId = null;
      return { success: false, error: error.message };
    }
  }

  if (uploadDropzone) {
    uploadDropzone.addEventListener('click', (e) => {
      if (!e.target.closest('label')) mediaFileInput.click();
    });
  }

  const uploadModalContent = document.getElementById('uploadModalContent');

  if (uploadModalContent) {
    let dragDepth = 0;

    uploadModalContent.addEventListener('dragenter', (e) => {
      e.preventDefault();
      e.stopPropagation();
      dragDepth++;
      if (uploadDropzone) uploadDropzone.classList.add('border-primary', 'bg-primary/10');
      if (selectedFileInfo) selectedFileInfo.classList.add('ring-2', 'ring-primary', 'bg-primary/5');
    });

    uploadModalContent.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.stopPropagation();
    });

    uploadModalContent.addEventListener('dragleave', (e) => {
      e.preventDefault();
      e.stopPropagation();
      dragDepth--;
      if (dragDepth <= 0) {
        dragDepth = 0;
        if (uploadDropzone) uploadDropzone.classList.remove('border-primary', 'bg-primary/10');
        if (selectedFileInfo) selectedFileInfo.classList.remove('ring-2', 'ring-primary', 'bg-primary/5');
      }
    });

    uploadModalContent.addEventListener('drop', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      dragDepth = 0;
      if (uploadDropzone) uploadDropzone.classList.remove('border-primary', 'bg-primary/10');
      if (selectedFileInfo) selectedFileInfo.classList.remove('ring-2', 'ring-primary', 'bg-primary/5');
      
      const droppedFiles = [];

      // 1. Synchronously snapshot all items/entries and files BEFORE any async await tick!
      const syncEntries = [];
      const syncFiles = [];

      if (e.dataTransfer) {
        if (e.dataTransfer.items && e.dataTransfer.items.length > 0) {
          for (let i = 0; i < e.dataTransfer.items.length; i++) {
            const item = e.dataTransfer.items[i];
            if (item.kind === 'file') {
              const entry = item.webkitGetAsEntry ? item.webkitGetAsEntry() : null;
              if (entry) {
                syncEntries.push(entry);
              } else {
                const f = item.getAsFile ? item.getAsFile() : null;
                if (f) syncFiles.push(f);
              }
            }
          }
        } else if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
          for (let i = 0; i < e.dataTransfer.files.length; i++) {
            syncFiles.push(e.dataTransfer.files[i]);
          }
        }
      }

      // 2. Read directory entries recursively from the synchronous snapshot
      const readEntryRecursive = async (entry) => {
        if (!entry) return;
        if (entry.isFile) {
          await new Promise(res => {
            entry.file(f => {
              if (f) droppedFiles.push(f);
              res();
            }, () => res());
          });
        } else if (entry.isDirectory) {
          const dirReader = entry.createReader();
          const readEntries = async () => {
            return new Promise(res => {
              dirReader.readEntries(async (entries) => {
                if (entries && entries.length > 0) {
                  for (const ent of entries) {
                    await readEntryRecursive(ent);
                  }
                  await readEntries();
                }
                res();
              }, () => res());
            });
          };
          await readEntries();
        }
      };

      for (const entry of syncEntries) {
        await readEntryRecursive(entry);
      }
      for (const f of syncFiles) {
        droppedFiles.push(f);
      }

      // Fallback: If neither entries nor files were captured via items, use dataTransfer.files
      if (droppedFiles.length === 0 && e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        droppedFiles.push(...Array.from(e.dataTransfer.files));
      }

      if (droppedFiles.length > 0) {
        handleFilesSelected(droppedFiles);
      }
    });
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function detectItemCategory(video) {
    const fp = (video.filepath || '').toLowerCase();
    const fmt = (video.format || '').toLowerCase();
    if (fp.includes('/audio/') || ['mp3', 'm4a', 'aac', 'wav', 'flac', 'ogg'].includes(fmt) || fp.endsWith('.m4a') || fp.endsWith('.aac') || fp.endsWith('.mp3')) {
      return 'audio';
    }
    if (['jpg', 'jpeg', 'png', 'webp', 'gif', 'image'].includes(fmt) || fp.endsWith('.jpg') || fp.endsWith('.jpeg') || fp.endsWith('.png') || fp.endsWith('.webp') || fp.endsWith('.gif')) {
      return 'image';
    }
    return 'video';
  }

  function formatGalleryDate(value) {
    if (!value) return '--';
    return new Date(value).toLocaleDateString();
  }

