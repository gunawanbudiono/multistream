<% layout('layout') -%>
<% function formatFileSize(bytes) { 
  if (!bytes || bytes === 0) return '0 B';
  bytes = Number(bytes);
  if (isNaN(bytes)) return '0 B';
  if (bytes < 1024) return bytes + ' B';
  else if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
  else if (bytes < 1073741824) return (bytes / 1048576).toFixed(1) + ' MB';
  else if (bytes < 1099511627776) return (bytes / 1073741824).toFixed(2) + ' GB';
  else return (bytes / 1099511627776).toFixed(2) + ' TB';
} 
function formatDuration(seconds) { 
  if (!seconds) return '0:00'; 
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  const secs = Math.floor(seconds % 60);
  if (hours > 0) return `${hours}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  return `${minutes}:${secs.toString().padStart(2, '0')}`;
} 
function detectMediaType(item) {
  const fp = (item.filepath || '').toLowerCase();
  const fmt = (item.format || '').toLowerCase();
  if (fp.includes('/audio/') || ['mp3', 'm4a', 'aac', 'wav', 'flac', 'ogg'].includes(fmt) || fp.endsWith('.m4a') || fp.endsWith('.aac') || fp.endsWith('.mp3')) {
    return 'audio';
  }
  if (['jpg', 'jpeg', 'png', 'webp', 'gif', 'image'].includes(fmt) || fp.endsWith('.jpg') || fp.endsWith('.jpeg') || fp.endsWith('.png') || fp.endsWith('.webp') || fp.endsWith('.gif')) {
    return 'image';
  }
  return 'video';
}
%>

<div id="galleryPageRoot">
<div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
  <div>
    <h2 class="text-2xl font-bold">Media Gallery</h2>
    <p class="text-gray-400 text-sm mt-1 flex items-center flex-wrap gap-2">
      <span>Manage your videos, audio, and images for streaming</span>
      <span id="diskUsageInfoDesktop" class="hidden items-center">
        <span class="text-gray-500 mx-1">•</span>
        <i class="ti ti-database text-xs mr-1 text-primary"></i>
        <span id="diskUsageTextDesktop" class="text-gray-300 font-medium"></span>
      </span>
    </p>
    <p id="diskUsageInfoMobile" class="hidden text-gray-400 text-sm mt-1">
      <i class="ti ti-database text-xs mr-1 text-primary"></i>
      <span id="diskUsageTextMobile" class="text-gray-300 font-medium"></span>
    </p>
  </div>
  <div class="flex gap-3">
    <button onclick="openUploadModal()" class="flex items-center gap-2 bg-primary hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-colors shadow-sm">
      <i class="ti ti-upload"></i>
      <span>Upload Media</span>
    </button>
    <div class="relative">
      <button onclick="toggleCloudDropdown()" class="flex items-center gap-2 bg-dark-700 border border-gray-600 hover:bg-dark-600 text-white px-4 py-2 rounded-lg transition-colors">
        <i class="ti ti-cloud-download"></i>
        <span>Import from Cloud</span>
        <i class="ti ti-chevron-down text-sm"></i>
      </button>
      <div id="cloudDropdown" class="hidden absolute right-0 mt-2 w-52 bg-dark-800 border border-gray-700 rounded-xl shadow-2xl z-50 overflow-hidden py-1">
        <button onclick="openCloudModal('gdrive')" class="w-full flex items-center gap-3 px-4 py-3 hover:bg-dark-700 text-left transition-colors border-b border-gray-700/50">
          <img src="/images/google drive.png" alt="Google Drive" class="w-5 h-5" loading="lazy" decoding="async">
          <div>
            <div class="font-medium text-sm text-gray-200">Google Drive</div>
            <div class="text-[11px] text-gray-400">Import files via link</div>
          </div>
        </button>
        <button onclick="openYouTubeDownloadModal()" class="w-full flex items-center gap-3 px-4 py-3 hover:bg-dark-700 text-left transition-colors">
          <div class="w-5 h-5 rounded flex items-center justify-center bg-red-600/20 text-red-500">
            <i class="ti ti-brand-youtube text-lg"></i>
          </div>
          <div>
            <div class="font-medium text-sm text-gray-200">YouTube</div>
            <div class="text-[11px] text-gray-400">Scan & download video/audio</div>
          </div>
        </button>
      </div>
    </div>
  </div>
</div>

<div class="space-y-4 mb-6">
  <div class="flex items-center gap-2 text-sm text-gray-400">
    <a href="/gallery" class="hover:text-white transition-colors">Gallery</a>
    <% if (currentFolder) { %>
    <i class="ti ti-chevron-right text-xs"></i>
    <span class="text-white font-medium"><%= currentFolder.name %></span>
    <% } %>
  </div>

  <% if (currentFolder) { %>
  <div id="rootDropZone" class="border border-dashed border-gray-600 rounded-lg px-4 py-3 text-sm text-gray-400 bg-dark-800/50 hover:bg-dark-800 transition-colors">
    Drag file here to move it back to root
  </div>
  <% } %>
</div>

<%
  const hasRootFolders = !currentFolder && folders && folders.length > 0;
  const galleryItemCount = (videos ? videos.length : 0) + (hasRootFolders ? folders.length : 0);
  const hasGalleryItems = galleryItemCount > 0;
%>

<div class="bg-gray-800 rounded-lg shadow-md overflow-hidden">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 border-b border-gray-700 gap-4">
    <div class="flex items-center gap-3 flex-wrap">
      <div class="relative w-full sm:w-64">
        <input type="text" id="searchInput" placeholder="Search files and folders..."
          class="w-full bg-dark-700 border border-gray-600 text-white pl-9 pr-4 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
        <i class="ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
      </div>
      <select id="typeFilter" class="bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
        <option value="all">All Media</option>
        <option value="video">Videos</option>
        <option value="audio">Audios</option>
        <option value="image">Images</option>
      </select>
      <select id="sortSelect" class="bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
        <option value="newest">Newest</option>
        <option value="oldest">Oldest</option>
        <option value="name">Name</option>
        <option value="size">Size</option>
      </select>
    </div>
    <div class="flex items-center gap-2">
      <% if (!currentFolder) { %>
      <button onclick="openCreateFolderDialog()" class="w-10 h-10 flex items-center justify-center bg-dark-700 border border-gray-600 hover:bg-dark-600 text-white rounded-lg transition-colors" title="Create folder" aria-label="Create folder">
        <i class="ti ti-folder-plus text-lg"></i>
      </button>
      <% } %>
      <div class="flex items-center bg-dark-700 border border-gray-600 rounded-lg overflow-hidden">
        <button id="gridViewBtn" class="px-3 py-2 bg-primary text-white" title="Grid view">
          <i class="ti ti-layout-grid"></i>
        </button>
        <button id="listViewBtn" class="px-3 py-2 text-gray-400 hover:text-white transition-colors" title="List view">
          <i class="ti ti-list"></i>
        </button>
      </div>
    </div>
  </div>

  <div id="galleryContent" class="p-4">
    <% if (hasGalleryItems) { %>
    <div id="gridView" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
      <% if (hasRootFolders) { %>
      <% folders.forEach(function(folder) { %>
      <a href="/gallery?folder=<%= folder.id %>" class="gallery-grid-item folder-drop-target group bg-dark-700 rounded-lg border border-transparent hover:border-gray-600 hover:bg-dark-600 transition-all p-4 flex flex-col justify-between min-h-[172px]"
        data-folder-id="<%= folder.id %>" data-kind="folder" data-type="folder" data-title="<%= folder.name %>" data-date="<%= folder.updated_at || folder.created_at %>" data-size="0">
        <div class="flex items-start justify-between gap-3">
          <div class="w-12 h-12 rounded-xl bg-primary/15 text-primary flex items-center justify-center flex-shrink-0">
            <i class="ti ti-folder text-3xl"></i>
          </div>
          <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <button class="text-gray-400 hover:text-white p-1" onclick="event.preventDefault(); event.stopPropagation(); showRenameFolderDialog('<%= folder.id %>', '<%= folder.name %>')">
              <i class="ti ti-pencil text-sm"></i>
            </button>
            <button class="text-gray-400 hover:text-red-400 p-1" onclick="event.preventDefault(); event.stopPropagation(); showDeleteFolderDialog('<%= folder.id %>', '<%= folder.name %>')">
              <i class="ti ti-trash text-sm"></i>
            </button>
          </div>
        </div>
        <div class="mt-4 min-w-0">
          <h3 class="font-medium text-sm text-white truncate"><%= folder.name %></h3>
          <p class="text-xs text-gray-400 mt-1"><%= folder.item_count || 0 %> item<%= (folder.item_count || 0) === 1 ? '' : 's' %></p>
        </div>
      </a>
      <% }); %>
      <% } %>
      <% videos.forEach(function(video) { 
        const mediaType = detectMediaType(video);
      %>
      <div class="gallery-grid-item file-item group bg-dark-700 rounded-lg overflow-hidden border border-transparent hover:border-gray-600 hover:bg-dark-600 transition-all cursor-pointer"
        data-id="<%= video.id %>" data-kind="file" data-title="<%= video.title %>" data-date="<%= video.upload_date %>" data-size="<%= video.file_size %>" data-type="<%= mediaType %>"
        draggable="true"
        onclick="playMedia('<%= video.id %>', '<%= video.title %>', '<%= mediaType %>')">
        <div class="aspect-video relative overflow-hidden bg-dark-950 flex items-center justify-center">
          <% 
            const isPortrait = video.resolution && (function() {
              const parts = (video.resolution || '').split('x');
              return parts.length === 2 && parseInt(parts[1]) > parseInt(parts[0]);
            })();
          %>
          <% if (mediaType === 'audio') { %>
          <div class="w-full h-full flex items-center justify-center bg-[#181818]">
            <div class="w-16 h-16 rounded-full bg-primary/20 flex items-center justify-center audio-visualizer">
              <i class="ti ti-music text-3xl text-primary"></i>
            </div>
          </div>
          <% } else if (isPortrait) { %>
          <img src="<%= video.thumbnail_path || video.filepath %>" alt="" class="absolute inset-0 w-full h-full object-cover blur-xl opacity-35 scale-125" loading="lazy" decoding="async">
          <img src="<%= video.thumbnail_path || video.filepath %>" alt="<%= video.title %>" class="h-full w-auto max-w-full object-contain relative z-10 mx-auto drop-shadow-md" loading="lazy" decoding="async">
          <% } else if (mediaType === 'image') { %>
          <img src="<%= video.thumbnail_path || video.filepath %>" alt="<%= video.title %>" class="w-full h-full object-contain p-0.5" loading="lazy" decoding="async">
          <% } else { %>
          <img src="<%= video.thumbnail_path %>" alt="<%= video.title %>" class="w-full h-full object-cover" loading="lazy" decoding="async">
          <% } %>
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-20">
            <div class="bg-primary/90 w-10 h-10 rounded-full flex items-center justify-center shadow-lg">
              <i class="ti <%= mediaType === 'image' ? 'ti-eye' : 'ti-player-play-filled' %> text-white"></i>
            </div>
          </div>
          <% if (mediaType === 'video' || mediaType === 'audio') { %>
          <span class="absolute bottom-2 right-2 bg-black/80 text-white text-xs px-1.5 py-0.5 rounded font-mono z-20">
            <%= formatDuration(video.duration) %>
          </span>
          <% } %>
          <% if (mediaType === 'video') { %>
          <span class="absolute top-2 left-2 bg-blue-600/90 text-white text-xs px-1.5 py-0.5 rounded flex items-center gap-1 z-20 font-medium shadow-sm">
            <i class="ti ti-video text-xs"></i>Video
          </span>
          <% } else if (mediaType === 'audio') { %>
          <span class="absolute top-2 left-2 bg-primary/80 text-white text-xs px-1.5 py-0.5 rounded flex items-center gap-1 z-20 font-medium shadow-sm">
            <i class="ti ti-music text-xs"></i>Audio
          </span>
          <% } else if (mediaType === 'image') { %>
          <span class="absolute top-2 left-2 bg-green-600/80 text-white text-xs px-1.5 py-0.5 rounded flex items-center gap-1 z-20 font-medium shadow-sm">
            <i class="ti ti-photo text-xs"></i>Image
          </span>
          <% } %>
        </div>
        <div class="p-3">
          <h3 class="font-medium text-sm truncate mb-1 text-white"><%= video.title %></h3>
          <div class="flex items-center justify-between">
            <span class="text-xs text-gray-400"><%= formatFileSize(video.file_size) %></span>
            <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              <button class="text-gray-400 hover:text-white p-1" onclick="event.stopPropagation(); showRenameDialog('<%= video.id %>', '<%= video.title %>')">
                <i class="ti ti-pencil text-sm"></i>
              </button>
              <button class="text-gray-400 hover:text-red-400 p-1" onclick="event.stopPropagation(); showDeleteDialog('<%= video.id %>', '<%= video.title %>')">
                <i class="ti ti-trash text-sm"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
      <% }); %>
    </div>

    <div id="listView" class="hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-gray-700">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Name</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider w-24">Duration</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider w-28">Size</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider w-32">Modified</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-300 uppercase tracking-wider w-24">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-700">
            <% if (hasRootFolders) { %>
            <% folders.forEach(function(folder) { %>
            <tr class="gallery-list-item folder-drop-target group hover:bg-dark-700 transition-colors cursor-pointer"
              data-folder-id="<%= folder.id %>" data-kind="folder" data-type="folder" data-title="<%= folder.name %>" data-date="<%= folder.updated_at || folder.created_at %>" data-size="0"
              onclick="window.location.href='/gallery?folder=<%= folder.id %>'">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-8 rounded bg-primary/15 text-primary flex-shrink-0 relative flex items-center justify-center">
                    <i class="ti ti-folder text-lg"></i>
                  </div>
                  <div class="flex items-center gap-2 min-w-0">
                    <span class="font-medium text-sm truncate max-w-xs text-white"><%= folder.name %></span>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500">--</td>
              <td class="px-4 py-3 text-sm text-gray-400"><%= folder.item_count || 0 %> item<%= (folder.item_count || 0) === 1 ? '' : 's' %></td>
              <td class="px-4 py-3 text-sm text-gray-400"><%= new Date(folder.updated_at || folder.created_at).toLocaleDateString() %></td>
              <td class="px-4 py-3 text-right">
                <div class="flex items-center justify-end gap-1">
                  <button class="p-1.5 hover:bg-dark-600 rounded text-gray-400 hover:text-white transition-colors"
                    onclick="event.preventDefault(); event.stopPropagation(); showRenameFolderDialog('<%= folder.id %>', '<%= folder.name %>')">
                    <i class="ti ti-pencil text-sm"></i>
                  </button>
                  <button class="p-1.5 hover:bg-dark-600 rounded text-gray-400 hover:text-red-400 transition-colors"
                    onclick="event.preventDefault(); event.stopPropagation(); showDeleteFolderDialog('<%= folder.id %>', '<%= folder.name %>')">
                    <i class="ti ti-trash text-sm"></i>
                  </button>
                </div>
              </td>
            </tr>
            <% }); %>
            <% } %>
            <% videos.forEach(function(video) { 
              const mediaType = detectMediaType(video);
            %>
            <tr class="gallery-list-item file-item-row group hover:bg-dark-700 transition-colors cursor-pointer"
              data-id="<%= video.id %>" data-kind="file" data-title="<%= video.title %>" data-date="<%= video.upload_date %>" data-size="<%= video.file_size %>" data-type="<%= mediaType %>"
              draggable="true"
              onclick="playMedia('<%= video.id %>', '<%= video.title %>', '<%= mediaType %>')">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-8 rounded overflow-hidden bg-dark-950 flex-shrink-0 relative flex items-center justify-center">
                    <% if (mediaType === 'audio') { %>
                    <i class="ti ti-music text-primary"></i>
                    <% } else if (mediaType === 'image') { %>
                    <img src="<%= video.thumbnail_path || video.filepath %>" alt="" class="w-full h-full object-contain p-0.5" loading="lazy" decoding="async">
                    <% } else { %>
                    <img src="<%= video.thumbnail_path %>" alt="" class="w-full h-full object-contain" loading="lazy" decoding="async">
                    <% } %>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="font-medium text-sm truncate max-w-xs text-white"><%= video.title %></span>
                    <% if (mediaType === 'audio') { %>
                    <span class="text-[10px] bg-primary/20 text-primary px-1.5 py-0.5 rounded">Audio</span>
                    <% } else if (mediaType === 'image') { %>
                    <span class="text-[10px] bg-green-500/20 text-green-400 px-1.5 py-0.5 rounded">Image</span>
                    <% } %>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 text-sm text-gray-400"><%= mediaType === 'image' ? '--' : formatDuration(video.duration) %></td>
              <td class="px-4 py-3 text-sm text-gray-400"><%= formatFileSize(video.file_size) %></td>
              <td class="px-4 py-3 text-sm text-gray-400"><%= new Date(video.upload_date).toLocaleDateString() %></td>
              <td class="px-4 py-3 text-right">
                <div class="flex items-center justify-end gap-1">
                  <button class="p-1.5 hover:bg-dark-600 rounded text-gray-400 hover:text-white transition-colors"
                    onclick="event.stopPropagation(); showRenameDialog('<%= video.id %>', '<%= video.title %>')">
                    <i class="ti ti-pencil text-sm"></i>
                  </button>
                  <button class="p-1.5 hover:bg-dark-600 rounded text-gray-400 hover:text-red-400 transition-colors"
                    onclick="event.stopPropagation(); showDeleteDialog('<%= video.id %>', '<%= video.title %>')">
                    <i class="ti ti-trash text-sm"></i>
                  </button>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% } else { %>
    <div class="text-center py-12">
      <div class="w-16 h-16 rounded-full bg-dark-700 flex items-center justify-center mx-auto mb-4">
        <i class="ti ti-folder text-gray-500 text-2xl"></i>
      </div>
      <h3 class="text-lg font-medium text-gray-300 mb-2">No items yet</h3>
      <p class="text-gray-500 text-sm mb-4">Upload videos, audio, images or create a folder to get started</p>
      <button onclick="openUploadModal()" class="inline-flex items-center gap-2 bg-primary hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-colors">
        <i class="ti ti-upload"></i>
        <span>Upload Media</span>
      </button>
    </div>
    <% } %>
  </div>

  <% if (hasGalleryItems) { %>
  <div id="galleryPaginationBar" class="px-4 py-3 border-t border-gray-700 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p id="paginationInfo" class="text-sm text-gray-400">Showing 1-<%= Math.min(galleryItemCount, 18) %> of <%= galleryItemCount %> items</p>
    <div id="paginationControls" class="flex items-center gap-2"></div>
  </div>
  <% } %>
</div>
</div>

<!-- All-in-One Universal Upload Modal with Live Preview & Tech Inspector -->
<div id="uploadModal" class="fixed inset-0 bg-black/70 backdrop-blur-md z-50 hidden modal-overlay overflow-y-auto">
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="bg-dark-800 rounded-2xl shadow-2xl w-full max-w-2xl border border-gray-700 overflow-hidden" id="uploadModalContent">
      <div class="flex items-center justify-between p-4 px-6 border-b border-gray-700 bg-dark-800">
        <div>
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="ti ti-cloud-upload text-primary text-xl"></i>
            <span>Upload Media</span>
          </h3>
          <p class="text-xs text-gray-400 mt-0.5">Live frame preview, tech inspection (resolution, FPS, keyframe, bitrate), and multi-format support</p>
        </div>
        <button onclick="minimizeUploadModal()" class="text-gray-400 hover:text-white p-1.5 rounded-lg hover:bg-dark-700 transition-colors" title="Close / Minimize to background">
          <i class="ti ti-x text-xl"></i>
        </button>
      </div>
      <div class="p-6">
        <form id="videoUploadForm" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="folderId" id="uploadFolderId" value="<%= currentFolderId || '' %>">
          
          <div id="uploadDropzone" class="border-2 border-dashed border-gray-600 hover:border-primary rounded-xl py-9 px-6 text-center transition-all cursor-pointer bg-dark-700/30 hover:bg-dark-700/60" data-state="idle">
            <div class="flex flex-col items-center justify-center space-y-3.5">
              <div class="w-16 h-16 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shadow-inner">
                <i id="dropzoneIcon" class="ti ti-cloud-upload text-3xl"></i>
              </div>
              <div>
                <p id="dropzoneText" class="text-gray-200 font-semibold text-base">Drag & drop videos, audio, and images here</p>
                <p class="text-gray-400 text-xs mt-1">Or click anywhere in this box to browse files</p>
              </div>
              
              <!-- Supported Formats Badges -->
              <div class="flex flex-wrap items-center justify-center gap-1.5 pt-1">
                <span class="inline-flex items-center gap-1 text-[11px] bg-blue-500/10 text-blue-400 border border-blue-500/20 px-2 py-0.5 rounded-md font-medium">
                  <i class="ti ti-video text-xs"></i> MP4, AVI, MOV, MKV, WebM
                </span>
                <span class="inline-flex items-center gap-1 text-[11px] bg-purple-500/10 text-purple-400 border border-purple-500/20 px-2 py-0.5 rounded-md font-medium">
                  <i class="ti ti-music text-xs"></i> MP3, M4A, AAC, WAV, FLAC
                </span>
                <span class="inline-flex items-center gap-1 text-[11px] bg-green-500/10 text-green-400 border border-green-500/20 px-2 py-0.5 rounded-md font-medium">
                  <i class="ti ti-photo text-xs"></i> JPG, PNG, WebP, GIF
                </span>
              </div>

              <label class="bg-primary hover:bg-blue-600 text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors inline-flex items-center gap-2 cursor-pointer shadow-md mt-2">
