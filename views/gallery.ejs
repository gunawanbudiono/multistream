  function buildFolderListMarkup(folder) {
    return `
      <tr class="gallery-list-item gallery-folder-link folder-drop-target group hover:bg-dark-700 transition-colors cursor-pointer"
        data-folder-id="${escapeHtml(folder.id)}" data-kind="folder" data-type="folder" data-title="${escapeHtml(folder.name)}" data-date="${escapeHtml(folder.updated_at || folder.created_at || '')}" data-size="0">
        <td class="px-4 py-3">
          <div class="flex items-center gap-3">
            <div class="w-12 h-8 rounded bg-primary/15 text-primary flex-shrink-0 relative flex items-center justify-center">
