          badgesHtml += `<span class="inline-flex items-center gap-1 text-[11px] bg-gray-700/60 text-gray-300 border border-gray-600/40 px-2 py-0.5 rounded-md font-medium">${meta.sizeFormatted} • ${meta.formatTag}</span>`;
