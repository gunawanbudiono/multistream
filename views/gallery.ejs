function openCloudModal(provider) {
  document.getElementById('cloudDropdown').classList.add('hidden');
  const modal = document.getElementById('cloudImportModal');
  const title = document.getElementById('cloudModalTitle');
  const body = document.getElementById('cloudModalBody');
  
  const titles = { gdrive: 'Google Drive', mediafire: 'Mediafire', dropbox: 'Dropbox', mega: 'MEGA' };
  title.textContent = `Import from ${titles[provider] || 'Cloud'}`;
  
  body.innerHTML = `
    <form id="cloudImportForm" class="p-6 space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-2">File URL</label>
        <input type="url" id="cloudFileUrl" required placeholder="Paste ${titles[provider]} public link here"
          class="w-full bg-dark-700 border border-gray-600 text-white px-3 py-2 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary">
      </div>
      <div id="cloudImportProgress" class="hidden">
        <div class="flex justify-between items-center text-sm mb-2">
          <span id="cloudProgressMsg" class="text-gray-400">Connecting...</span>
          <span id="cloudProgressPct" class="text-primary font-medium">0%</span>
        </div>
        <div class="w-full bg-dark-700 rounded-full h-2.5">
          <div id="cloudProgressBar" class="bg-primary h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>
      <div class="flex justify-end gap-3 pt-4 border-t border-gray-700">
        <button type="button" onclick="closeCloudModal()" class="px-4 py-2 bg-dark-700 hover:bg-dark-600 text-gray-300 rounded-lg">Cancel</button>
        <button type="submit" id="cloudSubmitBtn" class="px-4 py-2 bg-primary hover:bg-blue-600 text-white rounded-lg">Import</button>
      </div>
    </form>
  `;
  
  modal.classList.remove('hidden');
  document.body.classList.add('overflow-hidden');
  
  document.getElementById('cloudImportForm').addEventListener('submit', (e) => handleCloudImport(e, provider));
}

function closeCloudModal() {
  document.getElementById('cloudImportModal').classList.add('hidden');
  document.body.classList.remove('overflow-hidden');
}

document.getElementById('closeCloudBtn')?.addEventListener('click', closeCloudModal);

async function handleCloudImport(e, provider) {
  e.preventDefault();
  const url = document.getElementById('cloudFileUrl').value.trim();
  if (!url) return;
  
  const submitBtn = document.getElementById('cloudSubmitBtn');
  const progress = document.getElementById('cloudImportProgress');
  const progressMsg = document.getElementById('cloudProgressMsg');
  const progressBar = document.getElementById('cloudProgressBar');
  const progressPct = document.getElementById('cloudProgressPct');
  
  submitBtn.disabled = true;
  progress.classList.remove('hidden');
  
  const endpoints = {
    gdrive: '/api/videos/import-drive',
    mediafire: '/api/videos/import-mediafire',
    dropbox: '/api/videos/import-dropbox',
    mega: '/api/videos/import-mega'
  };
  
  const bodyPayload = { folderId: currentFolderId || '' };
  if (provider === 'gdrive') bodyPayload.driveUrl = url;
  else if (provider === 'mediafire') bodyPayload.mediafireUrl = url;
  else if (provider === 'dropbox') bodyPayload.dropboxUrl = url;
  else if (provider === 'mega') bodyPayload.megaUrl = url;
  
  try {
    const res = await fetch(endpoints[provider], {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(bodyPayload)
    });
    const data = await res.json();
    if (!data.success) throw new Error(data.error || 'Import failed to start');
    
    const jobId = data.jobId;
    const pollInterval = setInterval(async () => {
      try {
        const pollRes = await fetch(`/api/videos/import-status/${jobId}`);
        const pollData = await pollRes.json();
        
        if (pollData.status === 'downloading' || pollData.status === 'processing') {
          progressMsg.textContent = pollData.message || `${pollData.status}...`;
          progressBar.style.width = `${pollData.progress || 0}%`;
          progressPct.textContent = `${pollData.progress || 0}%`;
        } else if (pollData.status === 'completed') {
          clearInterval(pollInterval);
          showToast('success', 'File imported successfully');
          closeCloudModal();
          await window.refreshGalleryData?.();
          loadDiskUsage();
        } else if (pollData.status === 'failed') {
          clearInterval(pollInterval);
          throw new Error(pollData.message || 'Import failed');
        }
      } catch (err) {
        clearInterval(pollInterval);
        showToast('error', err.message);
        submitBtn.disabled = false;
      }
    }, 2000);
  } catch (err) {
    showToast('error', err.message);
    submitBtn.disabled = false;
  }
}

function makeModalDismissible(modal, closeCallback) {
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeCallback();
  });
  const onKey = (e) => {
    if (e.key === 'Escape') {
      document.removeEventListener('keydown', onKey);
      closeCallback();
    }
  };
  document.addEventListener('keydown', onKey);
}

function showRenameDialog(id, currentTitle) {
  const modal = document.createElement('div');
  modal.className = 'fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4';
