<script>
let currentView = 'grid';
let userDiskUsage = 0;
let userDiskLimit = 0;
const currentFolderId = <%- JSON.stringify(currentFolderId || '') %>;
let galleryVideosState = <%- JSON.stringify(videos || []) %>;
let galleryFoldersState = <%- JSON.stringify(folders || []) %>;
let galleryCurrentFolderState = <%- JSON.stringify(currentFolder || null) %>;

async function loadDiskUsage() {
  try {
    const response = await fetch('/api/user/disk-usage');
    const data = await response.json();
    if (data.success) {
      userDiskUsage = Number(data.diskUsage) || 0;
      userDiskLimit = Number(data.diskLimit) || 0;
      updateDiskUsageDisplay();
    }
  } catch (error) {
    console.error('Error loading disk usage:', error);
  }
}

function updateDiskUsageDisplay() {
  const infoDesktop = document.getElementById('diskUsageInfoDesktop');
  const textDesktop = document.getElementById('diskUsageTextDesktop');
  const infoMobile = document.getElementById('diskUsageInfoMobile');
  const textMobile = document.getElementById('diskUsageTextMobile');
  const modalQuotaSummary = document.getElementById('modalQuotaSummary');
  
  if (userDiskLimit > 0) {
    const usedText = formatFileSize(userDiskUsage);
    const limitText = formatFileSize(userDiskLimit);
    const percent = Math.min(100, Math.round((userDiskUsage / userDiskLimit) * 100));
    const displayText = `${usedText} / ${limitText} Used (${percent}%)`;
    
    if (textDesktop) textDesktop.textContent = displayText;
    if (textMobile) textMobile.textContent = displayText;
    if (modalQuotaSummary) {
      const remaining = Math.max(0, userDiskLimit - userDiskUsage);
      modalQuotaSummary.innerHTML = `<i class="ti ti-database text-xs mr-1 text-primary"></i> ${formatFileSize(remaining)} quota available`;
    }
    
    const isMobile = window.innerWidth < 768;
    if (isMobile) {
      if (infoDesktop) infoDesktop.classList.add('hidden');
      if (infoMobile) infoMobile.classList.remove('hidden');
    } else {
      if (infoDesktop) {
        infoDesktop.classList.remove('hidden');
        infoDesktop.classList.add('inline-flex');
      }
      if (infoMobile) infoMobile.classList.add('hidden');
    }
  } else {
    if (infoDesktop) infoDesktop.classList.add('hidden');
    if (infoMobile) infoMobile.classList.add('hidden');
    if (modalQuotaSummary) modalQuotaSummary.textContent = 'Unlimited storage quota';
  }
}

window.addEventListener('resize', updateDiskUsageDisplay);

function checkDiskLimit(fileSize) {
  if (userDiskLimit === 0) return true;
  return (userDiskUsage + fileSize) <= userDiskLimit;
}

function getRemainingSpace() {
  if (userDiskLimit === 0) return Infinity;
  return Math.max(0, userDiskLimit - userDiskUsage);
}

loadDiskUsage();

function formatFileSize(bytes) {
  if (!bytes || bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return (bytes / Math.pow(k, i)).toFixed(i > 2 ? 2 : 1) + ' ' + sizes[i];
}

function formatDuration(totalSeconds) {
  if (!totalSeconds) return '0:00';
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const secs = Math.floor(totalSeconds % 60);
  if (hours > 0) {
    return `${hours}:${String(minutes).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }
  return `${minutes}:${String(secs).padStart(2, '0')}`;
}

function showToast(type, message) {
  const toast = document.getElementById('toast');
  const toastIcon = document.getElementById('toast-icon');
  const toastMessage = document.getElementById('toast-message');
  if (type === 'success') {
    toastIcon.className = 'ti ti-check text-green-400 text-xl mr-2 font-loaded';
    toast.classList.add('border-l-4', 'border-green-400');
    toast.classList.remove('border-l-4', 'border-red-400', 'border-yellow-400');
  } else if (type === 'error') {
    toastIcon.className = 'ti ti-x text-red-400 text-xl mr-2 font-loaded';
    toast.classList.add('border-l-4', 'border-red-400');
    toast.classList.remove('border-l-4', 'border-green-400', 'border-yellow-400');
  } else if (type === 'warning') {
    toastIcon.className = 'ti ti-alert-triangle text-yellow-400 text-xl mr-2 font-loaded';
    toast.classList.add('border-l-4', 'border-yellow-400');
    toast.classList.remove('border-l-4', 'border-green-400', 'border-red-400');
  }
  toastMessage.textContent = message;
  toast.classList.remove('hidden');
  setTimeout(() => toast.classList.add('hidden'), 3000);
}

function applyGalleryViewMode() {
  const gridView = document.getElementById('gridView');
  const listView = document.getElementById('listView');
  const gridViewBtn = document.getElementById('gridViewBtn');
  const listViewBtn = document.getElementById('listViewBtn');

  if (gridView && listView) {
    gridView.classList.toggle('hidden', currentView !== 'grid');
    listView.classList.toggle('hidden', currentView !== 'list');
  }

  if (gridViewBtn && listViewBtn) {
    gridViewBtn.classList.toggle('bg-primary', currentView === 'grid');
    gridViewBtn.classList.toggle('text-white', currentView === 'grid');
    gridViewBtn.classList.toggle('text-gray-400', currentView !== 'grid');
    listViewBtn.classList.toggle('bg-primary', currentView === 'list');
    listViewBtn.classList.toggle('text-white', currentView === 'list');
    listViewBtn.classList.toggle('text-gray-400', currentView !== 'list');
  }
}

function initializeGalleryViewButtons() {
  const gridViewBtn = document.getElementById('gridViewBtn');
  const listViewBtn = document.getElementById('listViewBtn');
  if (gridViewBtn) {
    gridViewBtn.onclick = function() {
      currentView = 'grid';
      applyGalleryViewMode();
    };
  }
  if (listViewBtn) {
    listViewBtn.onclick = function() {
      currentView = 'list';
      applyGalleryViewMode();
    };
  }
  applyGalleryViewMode();
}

function playMedia(mediaId, mediaTitle, mediaType) {
  const modal = document.getElementById('mediaPreviewModal');
  const title = document.getElementById('previewModalTitle');
  const typeIcon = document.getElementById('previewModalTypeIcon');
  const videoCont = document.getElementById('previewVideoContainer');
  const audioCont = document.getElementById('previewAudioContainer');
  const imageCont = document.getElementById('previewImageContainer');
  const video = document.getElementById('previewNativeVideo');
  const audio = document.getElementById('previewNativeAudio');
  const image = document.getElementById('previewNativeImage');
  const spinner = document.getElementById('previewVideoSpinner');

  if (!modal) return;

  title.textContent = mediaTitle || 'Media Preview';

  videoCont.classList.add('hidden');
  audioCont.classList.add('hidden');
  imageCont.classList.add('hidden');

  const streamUrl = `/stream/${encodeURIComponent(mediaId)}`;

  if (mediaType === 'audio') {
    typeIcon.className = 'w-9 h-9 rounded-xl bg-purple-500/20 flex items-center justify-center shrink-0 text-purple-400';
    typeIcon.innerHTML = '<i class="ti ti-music text-lg"></i>';
    audioCont.classList.remove('hidden');
    audio.src = streamUrl;
    audio.play().catch(() => {});
  } else if (mediaType === 'image') {
    typeIcon.className = 'w-9 h-9 rounded-xl bg-green-500/20 flex items-center justify-center shrink-0 text-green-400';
    typeIcon.innerHTML = '<i class="ti ti-photo text-lg"></i>';
    imageCont.classList.remove('hidden');
    image.src = streamUrl;
  } else {
    typeIcon.className = 'w-9 h-9 rounded-xl bg-blue-500/20 flex items-center justify-center shrink-0 text-blue-400';
    typeIcon.innerHTML = '<i class="ti ti-video text-lg"></i>';
    videoCont.classList.remove('hidden');
    
    if (spinner) spinner.classList.remove('opacity-0', 'pointer-events-none');
    video.src = streamUrl;
    
    const hideSpinner = () => {
      if (spinner) spinner.classList.add('opacity-0', 'pointer-events-none');
    };
    
    video.onplaying = hideSpinner;
    video.oncanplay = hideSpinner;
    video.onloadeddata = hideSpinner;
    video.ontimeupdate = hideSpinner;
    video.onwaiting = () => {
      if (spinner) spinner.classList.remove('opacity-0', 'pointer-events-none');
    };

    video.play().catch((err) => {
      console.warn('Autoplay with audio blocked by browser policy:', err);
    });
  }

  modal.classList.remove('hidden');
  document.body.classList.add('overflow-hidden');
}

function closePreviewModal() {
  const modal = document.getElementById('mediaPreviewModal');
  const video = document.getElementById('previewNativeVideo');
  const audio = document.getElementById('previewNativeAudio');
  const image = document.getElementById('previewNativeImage');

  if (video) {
    video.pause();
    video.removeAttribute('src');
    video.load(); // Immediately aborts network HTTP stream
  }
  if (audio) {
    audio.pause();
    audio.removeAttribute('src');
    audio.load();
  }
  if (image) {
    image.removeAttribute('src');
  }

  if (modal) modal.classList.add('hidden');
  document.body.classList.remove('overflow-hidden');
}

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    const modal = document.getElementById('mediaPreviewModal');
    if (modal && !modal.classList.contains('hidden')) {
      closePreviewModal();
    }
  }
});

document.getElementById('mediaPreviewModal')?.addEventListener('click', (e) => {
  if (e.target.id === 'mediaPreviewModal') {
    closePreviewModal();
  }
});

function openUploadModal() {
  document.getElementById('uploadModal').classList.remove('hidden');
  document.body.classList.add('overflow-hidden');
}

function closeUploadModal() {
  document.getElementById('uploadModal').classList.add('hidden');
  document.body.classList.remove('overflow-hidden');
  resetUploadForm();
}

const activeObjectUrls = new Set();
function createTrackedObjectURL(blob) {
  const url = URL.createObjectURL(blob);
  activeObjectUrls.add(url);
  return url;
}
function revokeAllTrackedObjectURLs() {
  activeObjectUrls.forEach(url => {
    try { URL.revokeObjectURL(url); } catch (e) {}
  });
  activeObjectUrls.clear();
}

function setUploadButtonState(enabled) {
  const btn = document.getElementById('uploadButton');
  if (btn) {
    btn.disabled = !enabled;
    if (enabled) {
      btn.removeAttribute('disabled');
      btn.classList.remove('disabled:bg-gray-600', 'disabled:cursor-not-allowed', 'cursor-not-allowed');
    } else {
      btn.setAttribute('disabled', 'disabled');
      btn.classList.add('disabled:bg-gray-600', 'disabled:cursor-not-allowed');
    }
  }
}

document.addEventListener('click', (e) => {
  const uploadBtn = e.target.closest('#uploadButton');
  if (uploadBtn && !uploadBtn.disabled) {
    e.preventDefault();
    if (typeof window._triggerUploadProcess === 'function') {
      window._triggerUploadProcess();
    }
  }
});

function resetUploadForm() {
  revokeAllTrackedObjectURLs();
  selectedFiles = [];
  const form = document.getElementById('videoUploadForm');
  if (form) form.reset();
  document.getElementById('uploadDropzone')?.classList.remove('hidden');
  document.getElementById('selectedFileInfo')?.classList.add('hidden');
  document.getElementById('uploadProgress')?.classList.add('hidden');
  const selList = document.getElementById('selectedFilesList');
  if (selList) selList.innerHTML = '';
  const upBar = document.getElementById('uploadProgressBar');
  if (upBar) upBar.style.width = '0%';
  const upPct = document.getElementById('uploadProgressPercent');
  if (upPct) upPct.textContent = '0%';
  const metrics = document.getElementById('uploadProgressMetrics');
  if (metrics) metrics.textContent = 'Storage ready';
  
  const modalFooterAction = document.getElementById('modalFooterAction');
  if (modalFooterAction) {
    modalFooterAction.innerHTML = `
      <button type="button" onclick="closeUploadModal()" class="px-4 py-2 bg-dark-700 hover:bg-dark-600 text-gray-300 rounded-lg transition-colors text-sm font-medium">Cancel</button>
      <button type="button" id="uploadButton" onclick="window._triggerUploadProcess && window._triggerUploadProcess()" class="px-5 py-2 bg-primary hover:bg-blue-600 text-white rounded-lg transition-colors disabled:bg-gray-600 disabled:cursor-not-allowed text-sm font-medium shadow-md flex items-center gap-2" disabled>
        <i class="ti ti-upload text-base"></i>
        <span>Upload</span>
      </button>
    `;
  }
}

function toggleCloudDropdown() {
  const dd = document.getElementById('cloudDropdown');
  dd.classList.toggle('hidden');
}

document.addEventListener('click', (e) => {
  const dd = document.getElementById('cloudDropdown');
