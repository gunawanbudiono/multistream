    </div>
  `;
  document.body.appendChild(modal);
  const close = () => modal.remove();
  makeModalDismissible(modal, close);
  document.getElementById('cancelDeleteFolderBtn').onclick = close;
  const confirmBtn = document.getElementById('confirmDeleteFolderBtn');
  confirmBtn.onclick = async () => {
    confirmBtn.disabled = true;
    confirmBtn.innerHTML = '<i class="ti ti-loader animate-spin text-sm"></i> Deleting...';
    try {
      const res = await fetch(`/api/media-folders/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        showToast('success', 'Folder deleted successfully');
        close();
        await window.refreshGalleryData?.();
      } else {
        showToast('error', data.error || 'Failed to delete folder');
        confirmBtn.disabled = false;
        confirmBtn.innerHTML = 'Delete';
      }
    } catch (e) {
      showToast('error', e.message);
      confirmBtn.disabled = false;
      confirmBtn.innerHTML = 'Delete';
    }
  };
}

async function moveVideoToFolder(videoId, folderId) {
