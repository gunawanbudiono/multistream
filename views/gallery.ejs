  let uploadStartTime = 0;
  let batchTotalBytes = 0;
  const fileLoadedBytesMap = new Map();

  function updateBatchMetrics(currentFileIndex, currentFileName) {
    let totalSent = 0;
    fileLoadedBytesMap.forEach(b => totalSent += b);
    
    const overallPct = batchTotalBytes > 0 ? Math.min(100, Math.round((totalSent / batchTotalBytes) * 100)) : 0;
    uploadProgressBar.style.width = overallPct + '%';
    uploadProgressPercent.textContent = overallPct + '%';

    const now = Date.now();
    const elapsedSec = (now - uploadStartTime) / 1000;
    let speedLabel = '';
