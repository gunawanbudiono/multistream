          </div>
          ${mediaType !== 'image' ? `<span class="absolute bottom-2 right-2 bg-black/80 text-white text-xs px-1.5 py-0.5 rounded font-mono z-20">${formatDuration(video.duration)}</span>` : ''}
          ${topBadge}
