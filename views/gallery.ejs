let selectedFiles = [];
const CHUNK_SIZE = 50 * 1024 * 1024;
const fileMetadataCache = new WeakMap();

function getFileCategory(file) {
  const name = file.name.toLowerCase();
  const ext = '.' + name.split('.').pop();
  const type = file.type || '';
  
  const videoExts = ['.mp4', '.avi', '.mov', '.mkv', '.webm', '.flv', '.wmv', '.ts', '.m4v'];
  const audioExts = ['.mp3', '.wav', '.aac', '.m4a', '.ogg', '.flac'];
  const imageExts = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];

  if (type.startsWith('video/') || videoExts.includes(ext)) return 'video';
  if (type.startsWith('audio/') || audioExts.includes(ext)) return 'audio';
  if (type.startsWith('image/') || imageExts.includes(ext)) return 'image';
  return 'unknown';
}

function parseMp4FpsFromBuffer(arrayBuffer) {
  try {
    const bytes = new Uint8Array(arrayBuffer);
    const view = new DataView(arrayBuffer);
    let timescale = 0;

    for (let offset = 0; offset + 24 <= bytes.length; offset++) {
      if (bytes[offset] === 0x6D && bytes[offset+1] === 0x64 && bytes[offset+2] === 0x68 && bytes[offset+3] === 0x64) {
        const version = bytes[offset + 4];
        const tsOffset = (version === 1) ? (offset + 20) : (offset + 12);
        if (tsOffset + 4 <= bytes.length) {
          const ts = view.getUint32(tsOffset);
          if (ts > 0 && ts <= 1000000) timescale = ts;
        }
      }
      if (bytes[offset] === 0x73 && bytes[offset+1] === 0x74 && bytes[offset+2] === 0x74 && bytes[offset+3] === 0x73) {
        if (offset + 20 <= bytes.length) {
          const entryCount = view.getUint32(offset + 8);
          if (entryCount > 0) {
            const sampleDelta = view.getUint32(offset + 16);
            if (sampleDelta > 0) {
              const activeTimescale = timescale > 0 ? timescale : (sampleDelta <= 1001 ? 30000 : 1000);
              const rawFps = activeTimescale / sampleDelta;
              if (rawFps >= 10 && rawFps <= 240) {
                if (Math.abs(rawFps - 60) < 1.5 || Math.abs(rawFps - 59.94) < 1) return 60;
                if (Math.abs(rawFps - 30) < 1.5 || Math.abs(rawFps - 29.97) < 1) return 30;
                if (Math.abs(rawFps - 24) < 1.5 || Math.abs(rawFps - 23.976) < 1) return 24;
                if (Math.abs(rawFps - 25) < 1.5) return 25;
                if (Math.abs(rawFps - 50) < 1.5) return 50;
                return Math.round(rawFps);
              }
            }
          }
        }
      }
    }
  } catch (e) {}
  return null;
}

async function inspectMediaFile(file) {
  if (fileMetadataCache.has(file)) {
    return fileMetadataCache.get(file);
  }

  const category = getFileCategory(file);
  const ext = ('.' + file.name.split('.').pop()).toLowerCase();
  
  const meta = {
    category,
    ext,
    name: file.name,
    size: file.size,
    sizeFormatted: formatFileSize(file.size),
    thumbnailUrl: null,
    width: null,
    height: null,
    resolutionLabel: '',
    duration: 0,
    durationFormatted: '',
    bitrateLabel: '',
    fps: null,
    fpsLabel: '',
    keyframeLabel: '',
    formatTag: ext.toUpperCase().replace('.', '')
  };

  if (category === 'image') {
    try {
      const objUrl = createTrackedObjectURL(file);
      meta.thumbnailUrl = objUrl;
      const img = new Image();
      await new Promise((resolve) => {
        img.onload = () => {
          meta.width = img.naturalWidth;
          meta.height = img.naturalHeight;
          if (meta.width && meta.height) {
            let aspect = '';
            if (meta.width > meta.height) aspect = ' (Landscape)';
            else if (meta.height > meta.width) aspect = ' (Portrait)';
            else aspect = ' (1:1 Square)';
            meta.resolutionLabel = `${meta.width}×${meta.height} px${aspect}`;
          }
          resolve();
        };
        img.onerror = resolve;
        img.src = objUrl;
      });
    } catch (e) {}
  } else if (category === 'video') {
    try {
      const objUrl = createTrackedObjectURL(file);
      const video = document.createElement('video');
      video.preload = 'auto';
      video.muted = true;
      video.playsInline = true;
      video.src = objUrl;

      await new Promise((resolve) => {
        const timeout = setTimeout(() => {
          URL.revokeObjectURL(objUrl);
          resolve();
        }, 7000);

        video.onloadedmetadata = () => {
          meta.duration = video.duration || 0;
          meta.durationFormatted = formatDuration(meta.duration);
          meta.width = video.videoWidth;
          meta.height = video.videoHeight;

          if (meta.width && meta.height) {
            let tag = '';
            if (meta.width === 1920 && meta.height === 1080) tag = ' (16:9 FHD)';
            else if (meta.width === 1080 && meta.height === 1920) tag = ' (9:16 Shorts)';
            else if (meta.width === 3840 && meta.height === 2160) tag = ' (4K UHD)';
            else if (meta.width === 1280 && meta.height === 720) tag = ' (16:9 HD)';
            else if (meta.width > meta.height) tag = ' (Landscape)';
            else if (meta.height > meta.width) tag = ' (Portrait)';
            else tag = ' (1:1 Square)';

            meta.resolutionLabel = `${meta.width}×${meta.height}${tag}`;
          }

          if (meta.duration > 0 && file.size > 0) {
            const kbps = Math.round((file.size * 8) / meta.duration / 1000);
            if (kbps >= 1000) {
              meta.bitrateLabel = `~${(kbps / 1000).toFixed(1)} Mbps`;
            } else {
              meta.bitrateLabel = `~${kbps} kbps`;
            }
          }

          video.currentTime = Math.min(1.0, (video.duration || 2) / 2);
        };

        video.onseeked = () => {
          try {
            const canvas = document.createElement('canvas');
            canvas.width = 160;
            canvas.height = 90;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            meta.thumbnailUrl = canvas.toDataURL('image/jpeg', 0.85);
          } catch (err) {}
          clearTimeout(timeout);
          URL.revokeObjectURL(objUrl);
          resolve();
        };

        video.onerror = () => {
          clearTimeout(timeout);
          URL.revokeObjectURL(objUrl);
          resolve();
        };
      });

      // Dual-End MP4 Header Probe (Head + Tail)
      try {
        const headBuffer = await file.slice(0, 512 * 1024).arrayBuffer();
        let parsedFps = parseMp4FpsFromBuffer(headBuffer);
        if (!parsedFps && file.size > 512 * 1024) {
          const tailBuffer = await file.slice(Math.max(0, file.size - 512 * 1024), file.size).arrayBuffer();
          parsedFps = parseMp4FpsFromBuffer(tailBuffer);
        }

        if (parsedFps) {
          meta.fps = parsedFps;
          meta.fpsLabel = `${parsedFps} FPS`;
          meta.keyframeLabel = '2s Keyframe';
        } else {
          meta.fps = 30;
          meta.fpsLabel = '30 FPS';
          meta.keyframeLabel = '2s Keyframe';
        }
      } catch (e) {
        meta.fps = 30;
        meta.fpsLabel = '30 FPS';
        meta.keyframeLabel = '2s Keyframe';
      }

    } catch (e) {}
  } else if (category === 'audio') {
    try {
      const objUrl = URL.createObjectURL(file);
      const audio = document.createElement('audio');
      audio.preload = 'metadata';
      audio.src = objUrl;

      await new Promise((resolve) => {
        const timeout = setTimeout(() => {
          URL.revokeObjectURL(objUrl);
          resolve();
        }, 5000);

        audio.onloadedmetadata = () => {
          meta.duration = audio.duration || 0;
          meta.durationFormatted = formatDuration(meta.duration);
          if (meta.duration > 0 && file.size > 0) {
            const kbps = Math.round((file.size * 8) / meta.duration / 1000);
            if (kbps >= 1000) {
              meta.bitrateLabel = `${kbps} kbps (Lossless)`;
            } else if (kbps >= 320) {
              meta.bitrateLabel = `${kbps} kbps (HQ)`;
            } else if (kbps >= 192) {
              meta.bitrateLabel = `${kbps} kbps (HQ)`;
            } else if (kbps >= 128) {
              meta.bitrateLabel = `${kbps} kbps (Standard)`;
            } else {
              meta.bitrateLabel = `${kbps} kbps`;
            }
          }
          clearTimeout(timeout);
          URL.revokeObjectURL(objUrl);
          resolve();
        };

        audio.onerror = () => {
          clearTimeout(timeout);
          URL.revokeObjectURL(objUrl);
          resolve();
        };
      });
    } catch (e) {}
  }

  fileMetadataCache.set(file, meta);
  return meta;
}

document.addEventListener('DOMContentLoaded', function() {
  const mediaFileInput = document.getElementById('mediaFileInput');
  const selectedFileInfo = document.getElementById('selectedFileInfo');
  const selectedFileCount = document.getElementById('selectedFileCount');
  const selectedFilesList = document.getElementById('selectedFilesList');
  const clearFileButton = document.getElementById('clearFileButton');
  const uploadDropzone = document.getElementById('uploadDropzone');
  const uploadButton = document.getElementById('uploadButton');
  const uploadProgress = document.getElementById('uploadProgress');
  const uploadProgressBar = document.getElementById('uploadProgressBar');
  const uploadProgressPercent = document.getElementById('uploadProgressPercent');
  const uploadProgressStatus = document.getElementById('uploadProgressStatus');
  const uploadFilesList = document.getElementById('uploadFilesList');
  const searchInput = document.getElementById('searchInput');
  const sortSelect = document.getElementById('sortSelect');

  async function handleFilesSelected(newFiles) {
    if (!newFiles || newFiles.length === 0) return;
    const maxSize = 50 * 1024 * 1024 * 1024;
    const invalidFiles = [];
    const validFiles = [];

    newFiles.forEach(f => {
      const category = getFileCategory(f);
      if (category === 'unknown') {
        invalidFiles.push(f.name);
      } else if (f.size > maxSize) {
        showToast('error', `File too large (max 50GB): ${f.name}`);
      } else {
        validFiles.push(f);
      }
    });

    if (invalidFiles.length > 0) {
      showToast('error', `Unsupported file type: ${invalidFiles.join(', ')}`);
    }

    if (validFiles.length > 0) {
      const totalNewSize = validFiles.reduce((sum, f) => sum + f.size, 0);
      const totalSelectedSize = selectedFiles.reduce((sum, f) => sum + f.size, 0);
      if (userDiskLimit > 0 && (userDiskUsage + totalSelectedSize + totalNewSize) > userDiskLimit) {
        const remaining = getRemainingSpace() - totalSelectedSize;
        showToast('error', `Disk limit exceeded. Remaining space: ${formatFileSize(Math.max(0, remaining))}`);
        return;
      }

      validFiles.forEach(f => {
        if (!selectedFiles.some(e => e.name === f.name && e.size === f.size)) {
          selectedFiles.push(f);
        }
      });

      uploadDropzone.classList.add('hidden');
      selectedFileInfo.classList.remove('hidden');
      setUploadButtonState(true);
      await updateFilesList();
    }
  }

  if (mediaFileInput) {
    mediaFileInput.addEventListener('change', function() {
      handleFilesSelected(Array.from(this.files));
      this.value = '';
    });
  }

  async function updateFilesList() {
    const totalSize = selectedFiles.reduce((sum, f) => sum + f.size, 0);
    selectedFileCount.textContent = `${selectedFiles.length} file${selectedFiles.length > 1 ? 's' : ''} selected (${formatFileSize(totalSize)})`;
    selectedFilesList.innerHTML = '';
    setUploadButtonState(selectedFiles.length > 0);

    for (let i = 0; i < selectedFiles.length; i++) {
      const file = selectedFiles[i];
      const category = getFileCategory(file);
      
      const div = document.createElement('div');
      div.className = 'flex items-center justify-between p-3 rounded-xl bg-dark-700/80 border border-gray-700 hover:border-gray-600 transition-all shadow-sm gap-3';
      div.id = `selected-file-row-${i}`;
      
      div.innerHTML = `
        <div class="flex items-center gap-3.5 min-w-0 flex-1">
          <div class="w-20 h-15 rounded-lg bg-dark-600 flex items-center justify-center shrink-0 border border-gray-700 animate-pulse">
            <i class="ti ti-loader text-gray-400 text-lg animate-spin"></i>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-white truncate max-w-md">${file.name}</p>
            <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
              <span class="text-[10px] bg-dark-800 text-gray-300 px-2 py-0.5 rounded border border-gray-600/40 font-medium">${formatFileSize(file.size)}</span>
              <span class="text-[10px] text-gray-500">Inspecting metadata...</span>
            </div>
          </div>
        </div>
        <button type="button" class="text-gray-400 hover:text-red-400 p-2 rounded-lg hover:bg-dark-600 transition-colors shrink-0" data-index="${i}" title="Remove file">
          <i class="ti ti-trash text-base"></i>
        </button>
      `;

      div.querySelector('button').addEventListener('click', () => {
        selectedFiles.splice(i, 1);
        if (selectedFiles.length > 0) updateFilesList();
        else resetUploadForm();
      });

      selectedFilesList.appendChild(div);

      inspectMediaFile(file).then(meta => {
        let thumbContent = '';
        if (meta.thumbnailUrl) {
          thumbContent = `
            <img src="${meta.thumbnailUrl}" class="w-full h-full object-cover" loading="lazy" decoding="async">
            ${category === 'video' ? `<div class="absolute inset-0 bg-black/30 flex items-center justify-center"><i class="ti ti-player-play-filled text-white/90 text-sm"></i></div>` : ''}
            ${meta.durationFormatted ? `<span class="absolute bottom-1 right-1 bg-black/80 text-[10px] text-white px-1 rounded font-mono">${meta.durationFormatted}</span>` : ''}
          `;
        } else if (category === 'audio') {
          thumbContent = `
