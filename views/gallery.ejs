    if (elapsedSec > 0.4 && totalSent > 0) {
      const speedBps = totalSent / elapsedSec;
      speedLabel = ` • ⚡ ${formatFileSize(speedBps)}/s`;
      
      const remainingBytes = Math.max(0, batchTotalBytes - totalSent);
      if (speedBps > 0 && remainingBytes > 0) {
        const etaSec = Math.round(remainingBytes / speedBps);
