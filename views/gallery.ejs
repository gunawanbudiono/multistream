<script>
let currentView = 'grid';
let userDiskUsage = 0;
let userDiskLimit = 0;
const currentFolderId = <%- JSON.stringify(currentFolderId || '') %>;
let galleryVideosState = <%- JSON.stringify(videos || []) %>;
let galleryFoldersState = <%- JSON.stringify(folders || []) %>;
let galleryCurrentFolderState = <%- JSON.stringify(currentFolder || null) %>;

async function loadDiskUsage() {
  try {
    const response = await fetch('/api/user/disk-usage');
    const data = await response.json();
    if (data.success) {
      userDiskUsage = Number(data.diskUsage) || 0;
      userDiskLimit = Number(data.diskLimit) || 0;
      updateDiskUsageDisplay();
    }
  } catch (error) {
    console.error('Error loading disk usage:', error);
  }
}

function updateDiskUsageDisplay() {
  const infoDesktop = document.getElementById('diskUsageInfoDesktop');
  const textDesktop = document.getElementById('diskUsageTextDesktop');
  const infoMobile = document.getElementById('diskUsageInfoMobile');
  const textMobile = document.getElementById('diskUsageTextMobile');
  const modalQuotaSummary = document.getElementById('modalQuotaSummary');
  
  if (userDiskLimit > 0) {
    const usedText = formatFileSize(userDiskUsage);
    const limitText = formatFileSize(userDiskLimit);
    const percent = Math.min(100, Math.round((userDiskUsage / userDiskLimit) * 100));
    const displayText = `${usedText} / ${limitText} Used (${percent}%)`;
    
    if (textDesktop) textDesktop.textContent = displayText;
    if (textMobile) textMobile.textContent = displayText;
    if (modalQuotaSummary) {
      const remaining = Math.max(0, userDiskLimit - userDiskUsage);
      modalQuotaSummary.innerHTML = `<i class="ti ti-database text-xs mr-1 text-primary"></i> ${formatFileSize(remaining)} quota available`;
    }
    
    const isMobile = window.innerWidth < 768;
    if (isMobile) {
      if (infoDesktop) infoDesktop.classList.add('hidden');
      if (infoMobile) infoMobile.classList.remove('hidden');
    } else {
      if (infoDesktop) {
        infoDesktop.classList.remove('hidden');
        infoDesktop.classList.add('inline-flex');
      }
      if (infoMobile) infoMobile.classList.add('hidden');
    }
  } else {
    if (infoDesktop) infoDesktop.classList.add('hidden');
    if (infoMobile) infoMobile.classList.add('hidden');
    if (modalQuotaSummary) modalQuotaSummary.textContent = 'Unlimited storage quota';
  }
}

window.addEventListener('resize', updateDiskUsageDisplay);

function checkDiskLimit(fileSize) {
  if (userDiskLimit === 0) return true;
  return (userDiskUsage + fileSize) <= userDiskLimit;
}

function getRemainingSpace() {
  if (userDiskLimit === 0) return Infinity;
  return Math.max(0, userDiskLimit - userDiskUsage);
}

loadDiskUsage();

function formatFileSize(bytes) {
  if (!bytes || bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return (bytes / Math.pow(k, i)).toFixed(i > 2 ? 2 : 1) + ' ' + sizes[i];
}

function formatDuration(totalSeconds) {
  if (!totalSeconds) return '0:00';
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const secs = Math.floor(totalSeconds % 60);
  if (hours > 0) {
    return `${hours}:${String(minutes).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }
  return `${minutes}:${String(secs).padStart(2, '0')}`;
}

function showToast(type, message) {
  let toast = document.getElementById('toast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'toast';
    toast.className = 'fixed top-5 right-5 z-[99999] max-w-md bg-dark-800 border border-gray-700 shadow-2xl rounded-xl p-4 flex items-center gap-3 transition-all duration-300 transform translate-y-0 opacity-100 hidden';
    toast.innerHTML = `
      <i id="toast-icon" class="text-xl shrink-0"></i>
      <span id="toast-message" class="text-sm font-medium text-white flex-1 break-words"></span>
    `;
    document.body.appendChild(toast);
  }

  const toastIcon = document.getElementById('toast-icon');
  const toastMessage = document.getElementById('toast-message');

  toast.className = 'fixed top-5 right-5 z-[99999] max-w-md bg-dark-800 border shadow-2xl rounded-xl p-4 flex items-center gap-3 transition-all duration-300 transform translate-y-0 opacity-100';
  if (type === 'success') {
    toast.classList.add('border-green-500/50');
    if (toastIcon) toastIcon.className = 'ti ti-check text-green-400 text-xl shrink-0';
  } else if (type === 'error') {
    toast.classList.add('border-red-500/50');
    if (toastIcon) toastIcon.className = 'ti ti-alert-circle text-red-400 text-xl shrink-0';
  } else {
    toast.classList.add('border-amber-500/50');
    if (toastIcon) toastIcon.className = 'ti ti-alert-triangle text-amber-400 text-xl shrink-0';
  }

  if (toastMessage) toastMessage.textContent = message;
  toast.classList.remove('hidden');

  if (window._toastTimeout) clearTimeout(window._toastTimeout);
  window._toastTimeout = setTimeout(() => {
    toast.classList.add('hidden');
  }, 4000);
}

