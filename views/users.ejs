          const data = await res.json();
          if (data.success) {
            showToast(data.message, 'success');
          } else {
            showToast('Error: ' + data.error, 'error');
          }
        } catch (e) {
          showToast('Failed to revoke sessions', 'error');
        }
      }
    );
  }

  function toggleUserSuspend() {
    const userId = currentActiveEditUserId;
    if (!userId) return;
    const currentStatus = currentActiveEditStatus;
    const newStatus = currentStatus === 'active' ? 'inactive' : 'active';
    const actionLabel = newStatus === 'active' ? 'activate' : 'suspend';

    showConfirmModal(
      `${actionLabel === 'suspend' ? 'Suspend' : 'Activate'} User`,
      `Are you sure you want to ${actionLabel} user "${currentActiveEditUsername}"?`,
      async () => {
        try {
          const res = await fetch('/api/users/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId, status: newStatus })
          });
          const data = await res.json();
          if (data.success) {
            showToast(`User ${actionLabel}ed successfully`, 'success');
            closeEditModal();
            setTimeout(() => location.reload(), 1000);
          } else {
            showToast('Error: ' + data.message, 'error');
          }
        } catch (e) {
          showToast(`Failed to ${actionLabel} user`, 'error');
        }
      }
    );
  }

  function deleteUserFromModal() {
    const userId = currentActiveEditUserId;
    const username = currentActiveEditUsername;
    if (!userId) return;

    showConfirmModal(
      'Delete User Account',
      `Are you sure you want to permanently delete user "${username}"? All associated media files, playlists, and streams will be removed.`,
      async () => {
        try {
          const res = await fetch('/api/users/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId })
          });
          const data = await res.json();
          if (data.success) {
            showToast('User deleted successfully', 'success');
            closeEditModal();
            setTimeout(() => location.reload(), 1000);
          } else {
            showToast('Error: ' + data.message, 'error');
          }
        } catch (e) {
          showToast('Failed to delete user', 'error');
        }
      }
    );
  }

  // Edit Avatar selection preview
  document.getElementById('editAvatarInput').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
      document.getElementById('resetAvatarInput').value = '0';
      document.getElementById('editAvatarFileName').innerText = file.name;
      const reader = new FileReader();
      reader.onload = (e) => document.getElementById('editUserAvatar').src = e.target.result;
      reader.readAsDataURL(file);
    }
  });

  // Create Avatar selection preview
  document.getElementById('createAvatarInput').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
      document.getElementById('createAvatarFileName').innerText = file.name;
      const reader = new FileReader();
      reader.onload = (e) => document.getElementById('createUserAvatar').src = e.target.result;
      reader.readAsDataURL(file);
    }
  });

  // Edit User submit with loading state
  document.getElementById('editUserForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('editSubmitBtn');
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div><span>Saving...</span>';

    const formData = new FormData(this);
    try {
      const res = await fetch('/api/users/update', { method: 'POST', body: formData });
      const data = await res.json();
      if (data.success) {
        showToast('User updated successfully', 'success');
        closeEditModal();
        setTimeout(() => location.reload(), 1000);
      } else {
        btn.disabled = false;
        btn.innerHTML = origHtml;
        showToast('Error: ' + data.message, 'error');
      }
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML = origHtml;
      showToast('An error occurred while updating user', 'error');
    }
  });

  // Create User submit with loading state
  document.getElementById('createUserForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('createSubmitBtn');
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div><span>Creating...</span>';

    const formData = new FormData(this);
    try {
      const res = await fetch('/api/users/create', { method: 'POST', body: formData });
      const data = await res.json();
      if (data.success) {
        showToast('User created successfully', 'success');
        closeCreateModal();
        setTimeout(() => location.reload(), 1000);
      } else {
        btn.disabled = false;
        btn.innerHTML = origHtml;
        showToast('Error: ' + data.message, 'error');
      }
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML = origHtml;
      showToast('An error occurred while creating user', 'error');
    }
  });

  // Client-side table filter with Dynamic Empty State
  const searchInput = document.getElementById('searchInput');
  const roleFilter = document.getElementById('roleFilter');
  const statusFilter = document.getElementById('statusFilter');

  function filterUsers() {
    const query = searchInput.value.toLowerCase().trim();
    const role = roleFilter.value;
    const status = statusFilter.value;
    const tableBody = document.getElementById('usersTableBody');
    const userRows = document.querySelectorAll('.user-row');

    let visibleCount = 0;

    userRows.forEach(row => {
      const uName = row.getAttribute('data-username');
      const uRole = row.getAttribute('data-role');
      const uStatus = row.getAttribute('data-status');

      const matchSearch = !query || uName.includes(query);
      const matchRole = !role || uRole === role;
      const matchStatus = !status || uStatus === status;

      if (matchSearch && matchRole && matchStatus) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    let noMatchRow = document.getElementById('searchNoMatchRow');
    if (visibleCount === 0 && userRows.length > 0) {
      if (!noMatchRow) {
        noMatchRow = document.createElement('tr');
        noMatchRow.id = 'searchNoMatchRow';
        noMatchRow.innerHTML = `
          <td colspan="7" class="px-6 py-12 text-center text-gray-400">
            <i class="ti ti-search-off text-3xl mb-2 block text-gray-500"></i>
            <p class="text-sm font-semibold text-white">No matching users found</p>
            <p class="text-xs text-gray-400 mt-1">No user accounts matched your search criteria.</p>
          </td>
        `;
        tableBody.appendChild(noMatchRow);
      }
    } else if (noMatchRow) {
      noMatchRow.remove();
    }
  }

  searchInput.addEventListener('input', filterUsers);
  roleFilter.addEventListener('change', filterUsers);
  statusFilter.addEventListener('change', filterUsers);

  // Global Keyboard Escape Key Listener
  window.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' || e.keyCode === 27) {
      closeEditModal();
      closeInspectorModal();
      closeCreateModal();
      const confirmModal = document.getElementById('confirmModal');
      if (confirmModal && !confirmModal.classList.contains('hidden')) {
        document.getElementById('confirmCancelBtn').click();
      }
    }
  });
</script>