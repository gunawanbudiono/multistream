<% layout('layout') -%>

<!-- Page Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
  <div>
    <h2 class="text-2xl font-bold text-white">User Management</h2>
    <p class="text-gray-400 text-sm mt-1">Manage user accounts, storage limits, and streaming permissions</p>
  </div>
  <div>
    <button onclick="openCreateModal()" 
      class="px-4 py-2.5 bg-primary hover:bg-blue-600 text-white font-medium rounded-xl transition-all duration-200 shadow-lg shadow-blue-500/20 flex items-center gap-2">
      <i class="ti ti-plus text-lg"></i>
      <span>Create New User</span>
    </button>
  </div>
</div>

<!-- Top Statistics Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
  <!-- Total Users -->
  <div class="bg-dark-800 border border-[#27272a] rounded-2xl p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Total Users</p>
        <h3 class="text-2xl font-bold text-white mt-1"><%= globalStats ? globalStats.totalUsers : (users ? users.length : 0) %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-2xl">
        <i class="ti ti-users"></i>
      </div>
    </div>
    <div class="mt-3 flex items-center gap-2 text-xs text-gray-400">
      <span class="text-emerald-400 font-medium"><i class="ti ti-circle-check"></i> System Active</span>
      <span>•</span>
      <span>Ready to stream</span>
    </div>
  </div>

  <!-- Global Storage Pool -->
  <div class="bg-dark-800 border border-[#27272a] rounded-2xl p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Storage Used</p>
        <h3 class="text-2xl font-bold text-white mt-1"><%= globalStats ? globalStats.totalStorageUsed : '0 GB' %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-2xl">
        <i class="ti ti-database"></i>
      </div>
    </div>
    <div class="mt-3 flex items-center gap-2 text-xs text-gray-400">
      <span class="text-blue-400 font-medium"><%= globalStats ? globalStats.totalVideos : 0 %> Media Files</span>
      <span>•</span>
      <span><%= globalStats ? globalStats.diskFree : '469 GB' %> Free</span>
    </div>
  </div>

  <!-- Live Streaming Activity -->
  <div class="bg-dark-800 border border-[#27272a] rounded-2xl p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400">Live Streams</p>
        <h3 class="text-2xl font-bold text-white mt-1"><%= globalStats ? globalStats.totalActiveStreams : 0 %></h3>
      </div>
      <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-2xl">
        <i class="ti ti-broadcast"></i>
      </div>
    </div>
    <div class="mt-3 flex items-center gap-2 text-xs text-gray-400">
      <span class="<%= (globalStats && globalStats.totalActiveStreams > 0) ? 'text-emerald-400' : 'text-gray-500' %> font-medium">
        <i class="ti ti-circle-filled text-[10px]"></i> <%= (globalStats && globalStats.totalActiveStreams > 0) ? 'Broadcasting Now' : 'Idle Standby' %>
      </span>
    </div>
  </div>
</div>

<!-- Search & Filters -->
<div class="bg-dark-800 border border-[#27272a] rounded-2xl p-4 mb-6">
  <div class="flex flex-col sm:flex-row items-center gap-3">
    <div class="relative w-full sm:flex-1">
      <input type="text" id="searchInput" placeholder="Search user by username or ID..." 
        class="w-full bg-dark-900 text-white pl-10 pr-4 py-2.5 border border-[#27272a] rounded-xl focus:outline-none focus:border-primary text-sm transition-colors">
      <i class="ti ti-search absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-base"></i>
    </div>
    <div class="w-full sm:w-44">
      <select id="roleFilter" 
        class="w-full bg-dark-900 border border-[#27272a] text-white px-3.5 py-2.5 rounded-xl focus:outline-none focus:border-primary text-sm transition-colors">
        <option value="">All Roles</option>
        <option value="admin">Admin</option>
        <option value="member">Member</option>
      </select>
    </div>
    <div class="w-full sm:w-44">
      <select id="statusFilter" 
        class="w-full bg-dark-900 border border-[#27272a] text-white px-3.5 py-2.5 rounded-xl focus:outline-none focus:border-primary text-sm transition-colors">
        <option value="">All Statuses</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
      </select>
    </div>
  </div>
</div>

<!-- Users Table -->
<div class="bg-dark-800 border border-[#27272a] rounded-2xl overflow-hidden shadow-sm">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead class="bg-dark-900/60 border-b border-[#27272a]">
        <tr>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">User</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">Role</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">Status</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">Storage & Quota</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">Streams</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">Created</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider text-right">Actions</th>
        </tr>
      </thead>
      <tbody id="usersTableBody" class="divide-y divide-[#27272a]">
        <% if (users && users.length > 0) { %>
          <% users.forEach(function(user) { %>
            <tr class="hover:bg-dark-700/40 transition-colors user-row" 
                data-username="<%= user.username.toLowerCase() %>" 
                data-role="<%= user.user_role %>" 
                data-status="<%= user.status %>">
              
              <!-- User Info -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-3">
                  <div class="relative w-10 h-10 rounded-xl overflow-hidden bg-dark-900 border border-gray-700 flex-shrink-0">
                    <img src="<%= user.avatar_path || '/images/default-avatar.jpg' %>" 
                         alt="<%= user.username %>" 
                         class="w-full h-full object-cover" 
                         onerror="this.onerror=null; this.src='/images/default-avatar.jpg';">
                  </div>
                  <div>
                    <div class="text-sm font-semibold text-white flex items-center gap-1.5">
                      <span><%= user.username %></span>
                      <% if (user.id === req.session.userId) { %>
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-400 font-normal">You</span>
                      <% } %>
                    </div>
                    <div class="text-xs text-gray-400 font-mono">ID: <%= user.id ? user.id.substring(0, 8) + '...' : '--' %></div>
                  </div>
                </div>
              </td>

              <!-- Role -->
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (user.user_role === 'admin') { %>
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-lg bg-purple-500/10 text-purple-400 border border-purple-500/20">
                    <i class="ti ti-shield-check mr-1"></i> Admin
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-lg bg-blue-500/10 text-blue-400 border border-blue-500/20">
                    <i class="ti ti-user mr-1"></i> Member
                  </span>
                <% } %>
              </td>

              <!-- Status -->
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (user.status === 'active') { %>
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5"></span> Active
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-lg bg-rose-500/10 text-rose-400 border border-rose-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-400 mr-1.5"></span> Inactive
                  </span>
                <% } %>
              </td>

              <!-- Storage & Quota (Consistent GB units) -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex flex-col gap-1 w-44">
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-white font-semibold"><%= user.totalVideoSize || '0 GB' %></span>
                    <span class="text-gray-400">
                      <% if (user.quotaGb && user.quotaGb > 0) { %>
                        / <%= user.quotaGb %> GB
                      <% } else { %>
                        / Unlimited
                      <% } %>
                    </span>
                  </div>
                  <% if (user.quotaGb && user.quotaGb > 0) { %>
                    <div class="w-full bg-dark-900 rounded-full h-1.5 overflow-hidden">
                      <div class="bg-blue-500 h-1.5 rounded-full" style="width: <%= Math.min(100, user.quotaPercent || 0) %>%"></div>
                    </div>
                  <% } %>
                  <span class="text-[11px] text-gray-400"><%= user.videoCount || 0 %> videos uploaded</span>
                </div>
              </td>

              <!-- Streams -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex flex-col text-xs gap-1">
                  <span class="text-white font-medium"><%= user.streamCount || 0 %> Total Streams</span>
                  <% if (user.activeStreamCount > 0) { %>
                    <span class="text-emerald-400 flex items-center gap-1 font-semibold">
                      <i class="ti ti-circle-filled text-[8px] animate-pulse"></i> <%= user.activeStreamCount %> Online Now
                    </span>
                  <% } else { %>
                    <span class="text-gray-400">0 Online</span>
                  <% } %>
                </div>
              </td>

              <!-- Created At -->
              <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-400">
                <%= user.created_at ? new Date(user.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '--' %>
              </td>

              <!-- Actions (Swapped: [Detail] then [Impersonate]) -->
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <div class="flex items-center justify-end gap-2">
                  <!-- Detail Button (First on left) -->
                  <button onclick="editUser('<%= user.id %>', '<%= user.username %>', '<%= user.user_role %>', '<%= user.status %>', '<%= user.avatar_path || '' %>', '<%= user.disk_quota_gb || 0 %>')" 
                    class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-dark-900 text-gray-300 border border-[#27272a] hover:text-white hover:border-gray-500 transition-colors flex items-center gap-1.5" 
                    title="User Details & Settings">
                    <i class="ti ti-adjustments text-sm"></i>
                    <span>Detail</span>
                  </button>

                  <!-- Impersonate Button (Gold - Second on right) -->
                  <% if (user.id !== req.session.userId) { %>
                    <button onclick="impersonateUser('<%= user.id %>', '<%= user.username %>')" 
                      class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-[#392b15] text-[#fcd34d] border border-[#78350f] hover:bg-[#523d1c] transition-colors flex items-center gap-1"
                      title="Impersonate User">
                      <i class="ti ti-user-check"></i>
                      <span>Impersonate</span>
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr id="defaultEmptyState">
            <td colspan="7" class="px-6 py-12 text-center text-gray-400">
              <i class="ti ti-users text-4xl mb-2 block"></i>
              <p class="text-base font-medium text-white">No users found</p>
              <p class="text-xs text-gray-400 mt-1">Create a user account to get started.</p>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL: USER DETAILS & SETTINGS (HIGH FIDELITY) -->
<!-- ========================================== -->
<div id="editModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200">
  <div id="editModalContent" class="bg-[#18181b] border border-[#27272a] rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl transform scale-95 opacity-0 transition-all duration-200 flex flex-col max-h-[92vh]">
    
    <!-- Modal Header -->
    <div class="flex items-start justify-between px-6 pt-5 pb-3 border-b border-[#27272a]/60 flex-shrink-0">
      <div>
        <h3 class="text-lg font-bold text-white">User Details & Settings</h3>
        <p class="text-xs text-gray-400 mt-0.5">Edit user profile, avatar logo, password, or disk quota (GB)</p>
      </div>
      <button onclick="closeEditModal()" class="text-gray-400 hover:text-white transition-colors p-1 rounded-lg hover:bg-dark-800">
        <i class="ti ti-x text-lg"></i>
      </button>
    </div>

    <!-- Modal Form Body (Scrollable & No Autofill) -->
    <form id="editUserForm" autocomplete="off" class="p-6 space-y-4 overflow-y-auto flex-1 custom-scrollbar">
      <input type="hidden" id="editUserId" name="userId">
      <input type="hidden" id="resetAvatarInput" name="reset_avatar" value="0">
      
      <!-- Profile Photo / Avatar Logo Section with Reset Button -->
      <div>
        <label class="block text-xs font-medium text-gray-300 mb-1.5">Profile Photo / Avatar Logo</label>
        <div class="flex items-center gap-3 bg-dark-900 border border-[#27272a] rounded-xl p-2.5">
          <div class="w-10 h-10 rounded-full overflow-hidden bg-dark-800 border border-[#27272a] flex-shrink-0">
            <img id="editUserAvatar" src="/images/default-avatar.jpg" alt="Avatar" class="w-full h-full object-cover">
          </div>
          <label for="editAvatarInput" class="px-3 py-1.5 bg-primary hover:bg-blue-600 text-xs font-semibold text-white rounded-lg cursor-pointer transition-colors inline-flex items-center gap-1.5 shadow-sm flex-shrink-0">
            Choose File
          </label>
          <span id="editAvatarFileName" class="text-xs text-gray-400 truncate flex-1">No file chosen</span>
          <input type="file" id="editAvatarInput" name="avatar" accept="image/*" class="hidden">
          
          <!-- Reset to Default Avatar Button -->
          <button type="button" id="resetAvatarBtn" onclick="resetAvatarToDefault()" 
            class="p-2 text-gray-400 hover:text-rose-400 bg-dark-800 hover:bg-dark-700 border border-[#27272a] rounded-lg transition-colors flex-shrink-0" 
            title="Reset to Default Avatar">
            <i class="ti ti-trash text-sm"></i>
          </button>
        </div>
      </div>

      <!-- Username & Role (Side by Side in 2 Columns) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-gray-300 mb-1.5">Username</label>
          <input type="text" id="editUsername" name="username" required autocomplete="off"
            class="w-full bg-dark-900 border border-[#27272a] rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-primary transition-colors">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-300 mb-1.5">Role</label>
          <div class="relative">
            <select id="editRole" name="role"
              class="w-full bg-dark-900 border border-[#27272a] rounded-xl px-3.5 py-2.5 text-sm text-white appearance-none focus:outline-none focus:border-primary pr-8 transition-colors">
              <option value="member">Member</option>
              <option value="admin">Admin</option>
            </select>
            <i class="ti ti-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none text-xs"></i>
          </div>
        </div>
      </div>

      <!-- New Password with Eye Toggle & Strict Anti-Autofill -->
      <div>
        <label class="block text-xs font-medium text-gray-300 mb-1.5">
          New Password <span class="text-gray-500 font-normal">(Leave blank to keep current)</span>
        </label>
        <div class="relative">
          <input type="password" id="editPassword" name="password" placeholder="Enter new password" autocomplete="new-password"
            class="w-full bg-dark-900 border border-[#27272a] rounded-xl pl-3.5 pr-10 py-2.5 text-sm text-white focus:outline-none focus:border-primary transition-colors">
          <button type="button" onclick="togglePasswordVisibility('editPassword', 'editPasswordToggleIcon')" 
            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white transition-colors p-1">
            <i id="editPasswordToggleIcon" class="ti ti-eye-off text-base"></i>
          </button>
        </div>
        <div id="passwordStrengthContainer" class="mt-2 hidden">
          <div class="w-full bg-dark-950 rounded-full h-1.5 overflow-hidden">
            <div id="passwordStrengthBar" class="h-1.5 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
          <p id="passwordStrengthText" class="text-[11px] font-semibold mt-1"></p>
        </div>
      </div>

      <!-- Server Storage Overview Card (Reactive Live Progress Bar) -->
      <div class="bg-dark-900/70 border border-[#27272a] rounded-xl p-4 space-y-2.5">
        <div class="flex items-center justify-between text-xs">
          <span class="text-gray-300 font-semibold flex items-center gap-1.5">
            <i class="ti ti-database text-blue-400"></i> Server Storage Overview
          </span>
          <span class="text-gray-400">
            <strong class="text-emerald-400 font-bold" id="overviewFreeDisk"><%= globalStats ? globalStats.diskFree : '469.00 GB' %> Free</strong> / 489.61 GB Total
          </span>
        </div>
        <div class="w-full bg-dark-950 rounded-full h-2 overflow-hidden border border-gray-800">
          <div id="overviewProgressBar" class="bg-gradient-to-r from-blue-500 to-indigo-500 h-2 rounded-full transition-all duration-300" style="width: 25%"></div>
        </div>
        <div class="flex items-center justify-between text-[11px]">
          <span class="text-gray-400">Allocated (Member Users): <strong class="text-white font-semibold" id="overviewAllocated">0 GB</strong></span>
          <span class="text-emerald-400 font-semibold" id="overviewUnallocated">Unallocated Pool: 469 GB Available</span>
        </div>
      </div>

      <!-- Disk Quota Limit (GB) with Live Reactive Calculation -->
      <div>
        <label class="block text-xs font-medium text-gray-300 mb-1.5">
          Disk Quota Limit (GB) <span class="text-gray-500 font-normal">(e.g. 50 for 50 GB, 0 = Unlimited)</span>
        </label>
        <div class="relative flex items-center">
          <input type="number" id="editDiskQuotaGb" name="disk_quota_gb" min="0" placeholder="0" autocomplete="off"
            class="w-full bg-dark-900 border border-[#27272a] rounded-xl pl-3.5 pr-14 py-2.5 text-sm text-white focus:outline-none focus:border-primary transition-colors">
          <span class="absolute right-3 px-2 py-0.5 rounded bg-dark-800 text-xs font-semibold text-blue-400 border border-[#27272a]">GB</span>
        </div>
        <p class="text-[11px] text-emerald-400/90 mt-1.5 flex items-center gap-1">
          <i class="ti ti-info-circle"></i> Quota limit setting in Gigabytes (GB)
        </p>
      </div>

      <!-- Security & Session Control / Account Status Box -->
      <div class="bg-dark-900/70 border border-[#27272a] rounded-xl p-4 space-y-3.5">
        <!-- Revoke Sessions -->
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-xs font-semibold text-white">Security & Session Control</p>
            <p class="text-[11px] text-gray-400 mt-0.5">Revoke active login sessions across devices</p>
          </div>
          <button type="button" onclick="revokeUserSessions()" 
            class="px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-[#2b2010] text-[#fcd34d] border border-[#78350f] hover:bg-[#3d2e16] transition-colors flex items-center gap-1.5 flex-shrink-0">
            <i class="ti ti-logout text-sm"></i>
            <span>Revoke Sessions</span>
          </button>
        </div>

        <div class="h-px bg-[#27272a]"></div>

        <!-- Account Status (Suspend & Delete inside Modal) -->
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-xs font-semibold text-white">Account Status</p>
            <p class="text-[11px] text-gray-400 mt-0.5">Suspend access or delete user</p>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <button type="button" id="suspendUserBtn" onclick="toggleUserSuspend()" 
              class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20 hover:bg-amber-500/20 transition-colors flex items-center gap-1">
              <i class="ti ti-ban text-sm"></i>
              <span id="suspendBtnText">Suspend</span>
            </button>
            <button type="button" id="deleteUserBtn" onclick="deleteUserFromModal()" 
              class="px-3 py-1.5 text-xs font-semibold rounded-xl bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500/20 transition-colors flex items-center gap-1">
              <i class="ti ti-trash text-sm"></i>
              <span>Delete</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="pt-3 pb-1 flex items-center justify-end gap-3 flex-shrink-0 border-t border-[#27272a]">
        <button type="button" onclick="closeEditModal()" 
          class="px-5 py-2.5 text-sm text-gray-300 hover:text-white bg-dark-900 border border-[#27272a] rounded-xl transition-colors">
          Cancel
        </button>
        <button type="submit" 
          class="px-5 py-2.5 text-sm bg-primary hover:bg-blue-600 text-white font-medium rounded-xl transition-colors shadow-lg shadow-blue-500/20">
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL: CREATE USER -->
<!-- ========================================== -->
<div id="createModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200">
  <div id="createModalContent" class="bg-[#18181b] border border-[#27272a] rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl transform scale-95 opacity-0 transition-all duration-200">
    <div class="flex items-center justify-between px-6 py-4 border-b border-[#27272a]">
      <h3 class="text-lg font-bold text-white flex items-center gap-2">
        <i class="ti ti-user-plus text-blue-400"></i>
        <span>Create New User</span>
      </h3>
      <button onclick="closeCreateModal()" class="text-gray-400 hover:text-white transition-colors p-1 rounded-lg hover:bg-dark-800">
        <i class="ti ti-x text-lg"></i>
      </button>
    </div>

    <form id="createUserForm" autocomplete="off" class="p-6 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Username</label>
          <input type="text" id="createUsername" name="username" required placeholder="e.g. streaming_ops" autocomplete="off"
            class="w-full bg-dark-900 border border-[#27272a] rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-primary">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Password</label>
          <input type="password" id="createPassword" name="password" required placeholder="Minimum 6 characters" autocomplete="new-password"
            class="w-full bg-dark-900 border border-[#27272a] rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-primary">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Role</label>
          <select id="createRole" name="role"
            class="w-full bg-dark-900 border border-[#27272a] rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-primary">
            <option value="member" selected>Member</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1.5">Disk Quota Limit (GB)</label>
          <input type="number" id="createDiskQuotaGb" name="disk_quota_gb" min="0" placeholder="0 = Unlimited Pool" autocomplete="off"
            class="w-full bg-dark-900 border border-[#27272a] rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-primary">
        </div>
      </div>

      <div class="pt-4 border-t border-[#27272a] flex items-center justify-end gap-3">
        <button type="button" onclick="closeCreateModal()" 
          class="px-4 py-2 text-sm text-gray-400 hover:text-white bg-dark-900 border border-[#27272a] rounded-xl transition-colors">
          Cancel
        </button>
        <button type="submit" 
          class="px-4 py-2 text-sm bg-primary hover:bg-blue-600 text-white font-medium rounded-xl transition-colors shadow-lg shadow-blue-500/20">
          Create Account
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ========================================== -->
<!-- CUSTOM CONFIRMATION MODAL -->
<!-- ========================================== -->
<div id="confirmModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200">
  <div id="confirmModalContent" class="bg-[#18181b] border border-[#27272a] rounded-2xl w-full max-w-md p-6 shadow-2xl transform scale-95 opacity-0 transition-all duration-200 text-center">
    <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-2xl mx-auto mb-4">
      <i class="ti ti-alert-triangle"></i>
    </div>
    <h3 id="confirmTitle" class="text-lg font-bold text-white mb-2">Confirm Action</h3>
    <p id="confirmMessage" class="text-sm text-gray-400 mb-6">Are you sure you want to proceed?</p>
    <div class="flex items-center justify-center gap-3">
      <button id="confirmCancelBtn" class="px-4 py-2 text-sm text-gray-400 hover:text-white bg-dark-900 border border-[#27272a] rounded-xl transition-colors">
        Cancel
      </button>
      <button id="confirmOkBtn" class="px-5 py-2 text-sm bg-primary hover:bg-blue-600 text-white font-medium rounded-xl transition-colors">
        Confirm
      </button>
    </div>
  </div>
</div>

<!-- Toast Container (Top Center) -->
<div id="toastContainer" class="fixed top-6 left-1/2 -translate-x-1/2 z-[60] flex flex-col items-center gap-2 pointer-events-none"></div>

<!-- JavaScript Logic -->
<script>
  let currentActiveEditUserId = null;
  let currentActiveEditUsername = null;
  let currentActiveEditStatus = 'active';
  let totalServerDiskGB = 489.61;
  let otherUsersAllocatedGB = 0;

  // Pre-load all users quota data for dynamic calculation
  const allUsersData = <%- JSON.stringify((users || []).map(u => ({ id: u.id, quota: u.disk_quota_gb || 0 }))) %>;

  function showToast(message, type = 'info') {
    const container = document.getElementById('toastContainer');
    const toast = document.createElement('div');
    const colors = type === 'success' ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30' : 
                   type === 'error' ? 'bg-rose-500/20 text-rose-300 border-rose-500/30' : 
                   'bg-blue-500/20 text-blue-300 border-blue-500/30';
    const icon = type === 'success' ? 'ti-check' : type === 'error' ? 'ti-alert-circle' : 'ti-info-circle';
    
    toast.className = `flex items-center gap-2 px-5 py-3 rounded-xl border ${colors} bg-dark-900/90 shadow-2xl backdrop-blur-md text-sm font-semibold transition-all duration-300 pointer-events-auto opacity-0 -translate-y-3`;
    toast.innerHTML = `<i class="ti ${icon} text-lg"></i><span>${message}</span>`;
    container.appendChild(toast);
    
    setTimeout(() => {
      toast.classList.remove('opacity-0', '-translate-y-3');
      toast.classList.add('opacity-100', 'translate-y-0');
    }, 10);
    
    setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', '-translate-y-3');
      setTimeout(() => toast.remove(), 300);
    }, 3500);
  }

  function showConfirmModal(title, message, onConfirm) {
    const modal = document.getElementById('confirmModal');
    const content = document.getElementById('confirmModalContent');
    document.getElementById('confirmTitle').innerText = title;
    document.getElementById('confirmMessage').innerText = message;
    
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      content.classList.remove('opacity-0', 'scale-95');
    }, 10);

    const cancelBtn = document.getElementById('confirmCancelBtn');
    const okBtn = document.getElementById('confirmOkBtn');

    const cleanup = () => {
      modal.classList.add('opacity-0');
      content.classList.add('opacity-0', 'scale-95');
      setTimeout(() => modal.classList.add('hidden'), 200);
    };

    cancelBtn.onclick = cleanup;
    okBtn.onclick = () => {
      cleanup();
      onConfirm();
    };
  }

  function togglePasswordVisibility(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'ti ti-eye text-base text-blue-400';
    } else {
      input.type = 'password';
      icon.className = 'ti ti-eye-off text-base text-gray-400';
    }
  }

  // Real-time password strength meter
  document.getElementById('editPassword').addEventListener('input', function() {
    const val = this.value;
    const container = document.getElementById('passwordStrengthContainer');
    const bar = document.getElementById('passwordStrengthBar');
    const text = document.getElementById('passwordStrengthText');

    if (!val) {
      container.classList.add('hidden');
      return;
    }

    container.classList.remove('hidden');
    let strength = 0;
    if (val.length >= 6) strength += 25;
    if (val.length >= 10) strength += 25;
    if (/[A-Z]/.test(val) && /[a-z]/.test(val)) strength += 25;
    if (/[0-9]/.test(val) || /[^A-Za-z0-9]/.test(val)) strength += 25;

    if (strength <= 25) {
      bar.style.width = '25%';
      bar.className = 'h-1.5 rounded-full bg-rose-500';
      text.innerText = 'Password Strength: Weak';
      text.className = 'text-[11px] font-semibold mt-1 text-rose-400';
    } else if (strength <= 75) {
      bar.style.width = '60%';
      bar.className = 'h-1.5 rounded-full bg-amber-500';
      text.innerText = 'Password Strength: Medium';
      text.className = 'text-[11px] font-semibold mt-1 text-amber-400';
    } else {
      bar.style.width = '100%';
      bar.className = 'h-1.5 rounded-full bg-emerald-500';
      text.innerText = 'Password Strength: Strong';
      text.className = 'text-[11px] font-semibold mt-1 text-emerald-400';
    }
  });

  // Dynamic Live Storage Overview Calculation
  function updateStorageOverviewDynamic() {
    const quotaInput = document.getElementById('editDiskQuotaGb');
    const newTypedQuota = Math.max(0, parseInt(quotaInput.value) || 0);
    const totalAllocatedNow = otherUsersAllocatedGB + newTypedQuota;
    const percent = Math.min(100, Math.max(2, Math.round((totalAllocatedNow / totalServerDiskGB) * 100)));
    const unallocatedPool = Math.max(0, (totalServerDiskGB - totalAllocatedNow)).toFixed(2);

    document.getElementById('overviewAllocated').innerText = totalAllocatedNow + ' GB';
    document.getElementById('overviewUnallocated').innerText = 'Unallocated Pool: ' + unallocatedPool + ' GB Available';
    document.getElementById('overviewProgressBar').style.width = percent + '%';
  }

  document.getElementById('editDiskQuotaGb').addEventListener('input', updateStorageOverviewDynamic);
  document.getElementById('editDiskQuotaGb').addEventListener('change', updateStorageOverviewDynamic);

  function resetAvatarToDefault() {
    document.getElementById('editUserAvatar').src = '/images/default-avatar.jpg';
    document.getElementById('editAvatarFileName').innerText = 'Reset to default avatar';
    document.getElementById('editAvatarInput').value = '';
    document.getElementById('resetAvatarInput').value = '1';
    showToast('Photo reset to default avatar', 'info');
  }

  function openEditModal(userId, username, role, status, avatar, diskQuotaGb) {
    currentActiveEditUserId = userId;
    currentActiveEditUsername = username;
    currentActiveEditStatus = status;

    // Calculate other users allocated sum
    const otherUsers = allUsersData.filter(u => u.id !== userId);
    otherUsersAllocatedGB = otherUsers.reduce((sum, u) => sum + (Number(u.quota) || 0), 0);

    document.getElementById('editUserId').value = userId;
    document.getElementById('editUsername').value = username;
    document.getElementById('editRole').value = role;
    document.getElementById('editDiskQuotaGb').value = diskQuotaGb || 0;
    document.getElementById('resetAvatarInput').value = '0';
    document.getElementById('editUserAvatar').src = avatar || '/images/default-avatar.jpg';
    document.getElementById('editAvatarFileName').innerText = 'No file chosen';
    document.getElementById('editAvatarInput').value = '';

    // Clear password and prevent autofill override
    const pwdInput = document.getElementById('editPassword');
    pwdInput.value = '';
    pwdInput.type = 'password';
    document.getElementById('editPasswordToggleIcon').className = 'ti ti-eye-off text-base text-gray-400';
    document.getElementById('passwordStrengthContainer').classList.add('hidden');

    // Calculate dynamic storage bar for current user's quota
    updateStorageOverviewDynamic();

    // Update Suspend button text
    const suspendText = document.getElementById('suspendBtnText');
    if (status === 'inactive') {
      suspendText.innerText = 'Activate';
    } else {
      suspendText.innerText = 'Suspend';
    }

    const modal = document.getElementById('editModal');
    const content = document.getElementById('editModalContent');
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      content.classList.remove('opacity-0', 'scale-95');
      // Secondary safeguard against browser autofill
      pwdInput.value = '';
    }, 50);
  }

  function editUser(userId, username, role, status, avatar, diskQuotaGb) {
    openEditModal(userId, username, role, status, avatar, diskQuotaGb);
  }

  function closeEditModal() {
    const modal = document.getElementById('editModal');
    const content = document.getElementById('editModalContent');
    modal.classList.add('opacity-0');
    content.classList.add('opacity-0', 'scale-95');
    setTimeout(() => modal.classList.add('hidden'), 200);
  }

  function openCreateModal() {
    document.getElementById('createUserForm').reset();
    const modal = document.getElementById('createModal');
    const content = document.getElementById('createModalContent');
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      content.classList.remove('opacity-0', 'scale-95');
    }, 10);
  }

  function closeCreateModal() {
    const modal = document.getElementById('createModal');
    const content = document.getElementById('createModalContent');
    modal.classList.add('opacity-0');
    content.classList.add('opacity-0', 'scale-95');
    setTimeout(() => modal.classList.add('hidden'), 200);
  }

  function impersonateUser(userId, username) {
    showConfirmModal(
      'Impersonate User',
      `Are you sure you want to log in as "${username}"? You will switch to their account dashboard.`,
      async () => {
        try {
          const res = await fetch(`/api/users/${userId}/impersonate`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
          const data = await res.json();
          if (data.success) {
            showToast(`Switched to user ${username}`, 'success');
            setTimeout(() => window.location.href = '/dashboard', 800);
          } else {
            showToast('Error: ' + (data.error || data.message), 'error');
          }
        } catch (e) {
          showToast('Failed to impersonate user', 'error');
        }
      }
    );
  }

  function revokeUserSessions() {
    const userId = currentActiveEditUserId || document.getElementById('editUserId').value;
    if (!userId) return;
    showConfirmModal(
      'Revoke Active Sessions',
      'This will forcefully log out this user from all active devices and browsers.',
      async () => {
        try {
          const res = await fetch(`/api/users/${userId}/revoke-sessions`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
          const data = await res.json();
          if (data.success) {
            showToast(data.message, 'success');
          } else {
            showToast('Error: ' + data.error, 'error');
          }
        } catch (e) {
          showToast('Failed to revoke sessions', 'error');
        }
      }
    );
  }

  function toggleUserSuspend() {
    const userId = currentActiveEditUserId;
    if (!userId) return;
    const currentStatus = currentActiveEditStatus;
    const newStatus = currentStatus === 'active' ? 'inactive' : 'active';
    const actionLabel = newStatus === 'active' ? 'activate' : 'suspend';

    showConfirmModal(
      `${actionLabel === 'suspend' ? 'Suspend' : 'Activate'} User`,
      `Are you sure you want to ${actionLabel} user "${currentActiveEditUsername}"?`,
      async () => {
        try {
          const res = await fetch('/api/users/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId, status: newStatus })
          });
          const data = await res.json();
          if (data.success) {
            showToast(`User ${actionLabel}ed successfully`, 'success');
            closeEditModal();
            setTimeout(() => location.reload(), 1000);
          } else {
            showToast('Error: ' + data.message, 'error');
          }
        } catch (e) {
          showToast(`Failed to ${actionLabel} user`, 'error');
        }
      }
    );
  }

  function deleteUserFromModal() {
    const userId = currentActiveEditUserId;
    const username = currentActiveEditUsername;
    if (!userId) return;

    showConfirmModal(
      'Delete User Account',
      `Are you sure you want to permanently delete user "${username}"? All associated media files, playlists, and streams will be removed.`,
      async () => {
        try {
          const res = await fetch('/api/users/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId })
          });
          const data = await res.json();
          if (data.success) {
            showToast('User deleted successfully', 'success');
            closeEditModal();
            setTimeout(() => location.reload(), 1000);
          } else {
            showToast('Error: ' + data.message, 'error');
          }
        } catch (e) {
          showToast('Failed to delete user', 'error');
        }
      }
    );
  }

  document.getElementById('editAvatarInput').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
      document.getElementById('resetAvatarInput').value = '0';
      document.getElementById('editAvatarFileName').innerText = file.name;
      const reader = new FileReader();
      reader.onload = (e) => document.getElementById('editUserAvatar').src = e.target.result;
      reader.readAsDataURL(file);
    }
  });

  document.getElementById('editUserForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    try {
      const res = await fetch('/api/users/update', { method: 'POST', body: formData });
      const data = await res.json();
      if (data.success) {
        showToast('User updated successfully', 'success');
        closeEditModal();
        setTimeout(() => location.reload(), 1000);
      } else {
        showToast('Error: ' + data.message, 'error');
      }
    } catch (err) {
      showToast('An error occurred while updating user', 'error');
    }
  });

  document.getElementById('createUserForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    try {
      const res = await fetch('/api/users/create', { method: 'POST', body: formData });
      const data = await res.json();
      if (data.success) {
        showToast('User created successfully', 'success');
        closeCreateModal();
        setTimeout(() => location.reload(), 1000);
      } else {
        showToast('Error: ' + data.message, 'error');
      }
    } catch (err) {
      showToast('An error occurred while creating user', 'error');
    }
  });

  // Client-side table filter
  const searchInput = document.getElementById('searchInput');
  const roleFilter = document.getElementById('roleFilter');
  const statusFilter = document.getElementById('statusFilter');

  function filterUsers() {
    const query = searchInput.value.toLowerCase();
    const role = roleFilter.value;
    const status = statusFilter.value;

    document.querySelectorAll('.user-row').forEach(row => {
      const uName = row.getAttribute('data-username');
      const uRole = row.getAttribute('data-role');
      const uStatus = row.getAttribute('data-status');

      const matchSearch = !query || uName.includes(query);
      const matchRole = !role || uRole === role;
      const matchStatus = !status || uStatus === status;

      if (matchSearch && matchRole && matchStatus) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  searchInput.addEventListener('input', filterUsers);
  roleFilter.addEventListener('change', filterUsers);
  statusFilter.addEventListener('change', filterUsers);
</script>