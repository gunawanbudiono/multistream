<% layout('layout') -%>

<!-- Page Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
  <div>
    <h2 class="text-2xl font-bold text-white">User Management</h2>
    <p class="text-gray-400 text-sm mt-1">Manage user accounts, storage limits, and streaming permissions</p>
  </div>
  <div>
    <button onclick="openCreateModal()" 
      class="px-4 py-2.5 bg-primary hover:bg-blue-600 text-white font-medium rounded-xl transition-all duration-200 shadow-lg shadow-blue-500/20 flex items-center gap-2">
      <i class="ti ti-plus text-lg"></i>
      <span>Create New User</span>
    </button>
  </div>
</div>

<!-- Top Statistics Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <!-- Card 1: USER ACCOUNTS -->
  <div class="bg-dark-800 border border-[#27272a] rounded-2xl p-5 shadow-sm flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-400">User Accounts</p>
        <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-base border border-blue-500/20">
          <i class="ti ti-users"></i>
        </div>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-2xl font-bold text-white"><%= globalStats ? globalStats.totalUsers : 0 %></span>
        <span class="text-sm font-medium text-gray-400">Accounts Registered</span>
      </div>
      <div class="mt-2 flex items-center gap-3 text-xs">
        <span class="text-emerald-400 font-semibold flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span> <%= globalStats ? globalStats.activeCount : 0 %> Active
        </span>
        <span class="text-gray-500">•</span>
        <span class="text-gray-400 font-medium">
          <%= globalStats ? globalStats.suspendedCount : 0 %> Suspended
        </span>
      </div>
    </div>
    <div class="mt-4 pt-3 border-t border-[#27272a] flex items-center justify-between text-xs text-gray-500">
      <span><%= globalStats ? globalStats.adminCount : 1 %> Admin</span>
      <span><%= globalStats ? globalStats.memberCount : 0 %> Member Accounts</span>
    </div>
  </div>

  <!-- Card 2: GLOBAL STORAGE POOL -->
  <div class="bg-dark-800 border border-[#27272a] rounded-2xl p-5 shadow-sm flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Global Storage Pool</p>
        <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-base border border-emerald-500/20">
          <i class="ti ti-folder-plus"></i>
        </div>
      </div>
      <div class="mt-3 flex items-baseline gap-1.5">
        <span class="text-2xl font-bold text-emerald-400"><%= globalStats ? globalStats.unallocatedPoolGB : '489.61' %></span>
        <span class="text-sm font-medium text-emerald-400/90">GB Available</span>
      </div>
      <div class="mt-3 w-full bg-dark-900 rounded-full h-1.5 overflow-hidden border border-gray-800">
        <div class="bg-gradient-to-r from-blue-500 to-indigo-500 h-1.5 rounded-full" style="width: <%= globalStats ? Math.max(5, globalStats.allocatedPercent) : 5 %>%"></div>
      </div>
    </div>
    <div class="mt-4 pt-3 border-t border-[#27272a] flex items-center justify-between text-xs">
      <div class="flex items-center gap-2 text-gray-400">
        <span class="text-white font-semibold"><%= globalStats ? globalStats.totalAllocatedGB : 0 %> GB</span> Allocated
        <span class="text-gray-600">•</span>
        <span class="text-blue-400 font-medium"><%= globalStats ? globalStats.totalVideos : 0 %> Media Files</span>
      </div>
      <span class="text-gray-400"><%= globalStats ? globalStats.diskFree : '469.00 GB' %> Physical Free</span>
    </div>
  </div>

  <!-- Card 3: LIVE STREAMING ACTIVITY -->
  <div class="bg-dark-800 border border-[#27272a] rounded-2xl p-5 shadow-sm flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Live Streaming Activity</p>
        <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-base border border-purple-500/20">
          <i class="ti ti-device-gamepad-2"></i>
        </div>
      </div>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="text-2xl font-bold text-white"><%= globalStats ? globalStats.totalStreams : 0 %></span>
        <span class="text-sm font-medium text-gray-400">Channels Configured</span>
      </div>
      <div class="mt-2 flex items-center gap-3 text-xs">
        <span class="<%= (globalStats && globalStats.activeStreams > 0) ? 'text-emerald-400' : 'text-gray-400' %> font-semibold flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full <%= (globalStats && globalStats.activeStreams > 0) ? 'bg-emerald-400 animate-pulse' : 'bg-gray-600' %>"></span>
          <%= globalStats ? globalStats.activeStreams : 0 %> Online
        </span>
        <span class="text-gray-600">•</span>
        <span class="text-gray-400 font-medium"><%= globalStats ? globalStats.offlineStreams : 0 %> Offline</span>
      </div>
    </div>
    <div class="mt-4 pt-3 border-t border-[#27272a] flex items-center justify-between text-xs text-gray-500">
      <span>Multi-Channel RTMP</span>
    </div>
  </div>
</div>

<!-- Search & Filters -->
<div class="bg-dark-800 border border-[#27272a] rounded-2xl p-4 mb-6">
  <div class="flex flex-col sm:flex-row items-center gap-3">
    <div class="relative w-full sm:flex-1">
      <input type="text" id="searchInput" placeholder="Search user by username or ID..." 
        class="w-full bg-dark-900 text-white pl-10 pr-4 py-2.5 border border-[#27272a] rounded-xl focus:outline-none focus:border-primary text-sm transition-colors">
      <i class="ti ti-search absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-base"></i>
    </div>
    <div class="w-full sm:w-44">
      <select id="roleFilter" 
        class="w-full bg-dark-900 border border-[#27272a] text-white px-3.5 py-2.5 rounded-xl focus:outline-none focus:border-primary text-sm transition-colors">
        <option value="">All Roles</option>
        <option value="admin">Admin</option>
        <option value="member">Member</option>
      </select>
    </div>
    <div class="w-full sm:w-44">
      <select id="statusFilter" 
        class="w-full bg-dark-900 border border-[#27272a] text-white px-3.5 py-2.5 rounded-xl focus:outline-none focus:border-primary text-sm transition-colors">
        <option value="">All Statuses</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
      </select>
    </div>
  </div>
</div>

<!-- Users Table -->
<div class="bg-dark-800 border border-[#27272a] rounded-2xl overflow-hidden shadow-sm">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead class="bg-dark-900/60 border-b border-[#27272a]">
        <tr>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">User</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">Role</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">Status</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">Storage & Quota</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">Streams</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">Last Login & Created</th>
          <th class="px-6 py-4 text-xs font-semibold text-gray-400 uppercase tracking-wider text-right">Actions</th>
        </tr>
      </thead>
      <tbody id="usersTableBody" class="divide-y divide-[#27272a]">
        <% if (users && users.length > 0) { %>
          <% users.forEach(function(user) { %>
            <tr class="hover:bg-dark-700/40 transition-colors user-row" 
                data-username="<%= user.username.toLowerCase() %>" 
                data-role="<%= user.user_role %>" 
                data-status="<%= user.status %>">
              
              <!-- User Info -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-3">
                  <div class="relative w-10 h-10 rounded-xl overflow-hidden bg-dark-900 border border-gray-700 flex-shrink-0">
                    <img src="<%= user.avatar_path || '/images/default-avatar.jpg' %>" 
                         alt="<%= user.username %>" 
                         class="w-full h-full object-cover" 
                         onerror="this.onerror=null; this.src='/images/default-avatar.jpg';">
                  </div>
                  <div>
                    <div class="text-sm font-semibold text-white flex items-center gap-1.5">
                      <span><%= user.username %></span>
                      <% if (user.id === req.session.userId) { %>
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-400 font-normal">You</span>
                      <% } %>
                    </div>
                    <div class="text-xs text-gray-400 font-mono">ID: <%= user.id ? user.id.substring(0, 8) + '...' : '--' %></div>
                  </div>
                </div>
              </td>

              <!-- Role -->
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (user.user_role === 'admin') { %>
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-lg bg-purple-500/10 text-purple-400 border border-purple-500/20">
                    <i class="ti ti-shield-check mr-1"></i> Admin
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-lg bg-blue-500/10 text-blue-400 border border-blue-500/20">
                    <i class="ti ti-user mr-1"></i> Member
                  </span>
                <% } %>
              </td>

              <!-- Status -->
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (user.status === 'active') { %>
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5"></span> Active
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-lg bg-rose-500/10 text-rose-400 border border-rose-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-400 mr-1.5"></span> Inactive
                  </span>
                <% } %>
              </td>

              <!-- Storage & Quota (With Quick Peek Trigger) -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex flex-col gap-1 w-44">
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-white font-semibold"><%= user.totalVideoSize || '0 GB' %></span>
                    <span class="text-gray-400">
                      <% if (user.quotaGb && user.quotaGb > 0) { %>
                        / <%= user.quotaGb %> GB
                      <% } else { %>
                        / Unlimited
                      <% } %>
                    </span>
                  </div>
                  <% if (user.quotaGb && user.quotaGb > 0) { %>
                    <div class="w-full bg-dark-900 rounded-full h-1.5 overflow-hidden">
                      <div class="bg-blue-500 h-1.5 rounded-full" style="width: <%= Math.min(100, user.quotaPercent || 0) %>%"></div>
                    </div>
                  <% } %>
                  <button onclick="openInspectorModal('<%= user.id %>', '<%= user.username %>', '<%= user.user_role %>', '<%= user.avatar_path || '' %>', 'videos')" 
                    class="text-[11px] text-blue-400 hover:text-blue-300 font-medium flex items-center gap-1 transition-colors text-left group">
                    <i class="ti ti-eye text-xs group-hover:scale-110 transition-transform"></i>
                    <span><%= user.videoCount || 0 %> videos uploaded</span>
                  </button>
                </div>
              </td>

              <!-- Streams (With Quick Peek Trigger) -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex flex-col text-xs gap-1">
                  <button onclick="openInspectorModal('<%= user.id %>', '<%= user.username %>', '<%= user.user_role %>', '<%= user.avatar_path || '' %>', 'streams')" 
                    class="text-white font-medium hover:text-blue-400 flex items-center gap-1.5 transition-colors text-left group">
                    <span><%= user.streamCount || 0 %> Total Streams</span>
                    <i class="ti ti-eye text-xs text-gray-500 group-hover:text-blue-400 transition-colors"></i>
                  </button>
                  <% if (user.activeStreamCount > 0) { %>
                    <span class="text-emerald-400 flex items-center gap-1 font-semibold">
                      <i class="ti ti-circle-filled text-[8px] animate-pulse"></i> <%= user.activeStreamCount %> Online Now
                    </span>
                  <% } else { %>
                    <span class="text-gray-400">0 Online</span>
                  <% } %>
                </div>
              </td>

              <!-- Last Login & Created (Accurate Jakarta WIB Format) -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex flex-col">
                  <% if (user.last_login_at) { %>
                    <div class="text-xs font-semibold text-white flex items-center gap-1.5" title="<%= helpers.formatDateTime(user.last_login_at) %>">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      <span><%= helpers.formatRelativeTime(user.last_login_at) %></span>
                      <span class="text-[10px] text-gray-400 font-normal">(<%= helpers.formatDateTime(user.last_login_at) %>)</span>
                    </div>
                  <% } else { %>
                    <div class="text-xs text-gray-500 italic flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
                      <span>Never logged in</span>
                    </div>
                  <% } %>
                  <div class="text-[11px] text-gray-400 mt-1 flex items-center gap-1">
                    <i class="ti ti-calendar text-[10px] text-gray-500"></i>
                    <span>Joined <%= helpers.formatDateTime(user.created_at) %></span>
                  </div>
                </div>
              </td>

              <!-- Actions (Swapped: [Detail] then [Impersonate]) -->
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <div class="flex items-center justify-end gap-2">
                  <!-- Detail Button (First on left) -->
                  <button onclick="editUser('<%= user.id %>', '<%= user.username %>', '<%= user.user_role %>', '<%= user.status %>', '<%= user.avatar_path || '' %>', '<%= user.disk_quota_gb || 0 %>')" 
                    class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-dark-900 text-gray-300 border border-[#27272a] hover:text-white hover:border-gray-500 transition-colors flex items-center gap-1.5" 
                    title="User Details & Settings">
                    <i class="ti ti-adjustments text-sm"></i>
                    <span>Detail</span>
                  </button>

                  <!-- Impersonate Button (Gold - Second on right) -->
                  <% if (user.id !== req.session.userId) { %>
                    <button onclick="impersonateUser('<%= user.id %>', '<%= user.username %>')" 
                      class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-[#392b15] text-[#fcd34d] border border-[#78350f] hover:bg-[#523d1c] transition-colors flex items-center gap-1"
                      title="Impersonate User">
                      <i class="ti ti-user-check"></i>
                      <span>Impersonate</span>
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr id="defaultEmptyState">
            <td colspan="7" class="px-6 py-12 text-center text-gray-400">
              <i class="ti ti-users text-4xl mb-2 block"></i>
              <p class="text-base font-medium text-white">No users found</p>
              <p class="text-xs text-gray-400 mt-1">Create a user account to get started.</p>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL: USER ASSETS, STREAMS & LOGS INSPECTOR -->
<!-- ========================================== -->
<div id="inspectorModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200">
  <div id="inspectorModalContent" class="bg-[#18181b] border border-[#27272a] rounded-2xl w-full max-w-3xl overflow-hidden shadow-2xl transform scale-95 opacity-0 transition-all duration-200 flex flex-col max-h-[90vh]">
    
    <!-- Modal Header -->
    <div class="px-6 pt-5 pb-4 border-b border-[#27272a]/70 flex-shrink-0 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl overflow-hidden bg-dark-900 border border-[#27272a] flex-shrink-0">
          <img id="inspectorAvatar" src="/images/default-avatar.jpg" alt="Avatar" class="w-full h-full object-cover">
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 id="inspectorUsername" class="text-base font-bold text-white">--</h3>
            <span id="inspectorRoleBadge" class="text-[10px] px-2 py-0.5 rounded-md font-semibold uppercase bg-blue-500/10 text-blue-400 border border-blue-500/20">--</span>
          </div>
          <p class="text-xs text-gray-400 mt-0.5">Quick inspection of media files, live broadcasts, and activity logs</p>
        </div>
      </div>
      <button onclick="closeInspectorModal()" class="text-gray-400 hover:text-white transition-colors p-1.5 rounded-lg hover:bg-dark-800">
        <i class="ti ti-x text-lg"></i>
      </button>
    </div>

    <!-- 3-Tab Bar -->
    <div class="px-6 pt-2 flex items-center gap-2 border-b border-[#27272a] bg-dark-900/40 flex-shrink-0">
      <button type="button" id="tabBtnVideos" onclick="switchInspectorTab('videos')" 
        class="px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-primary text-white flex items-center gap-2 transition-all">
        <i class="ti ti-video text-base text-blue-400"></i>
        <span>Media Files</span>
        <span id="inspectorVideoCountBadge" class="px-1.5 py-0.5 rounded-full bg-blue-500/20 text-blue-300 text-[10px]">0</span>
      </button>
      <button type="button" id="tabBtnStreams" onclick="switchInspectorTab('streams')" 
        class="px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-gray-400 hover:text-gray-200 flex items-center gap-2 transition-all">
        <i class="ti ti-broadcast text-base text-purple-400"></i>
        <span>Live Streams</span>
        <span id="inspectorStreamCountBadge" class="px-1.5 py-0.5 rounded-full bg-purple-500/20 text-purple-300 text-[10px]">0</span>
      </button>
      <button type="button" id="tabBtnLogs" onclick="switchInspectorTab('logs')" 
        class="px-4 py-2.5 text-xs font-semibold rounded-t-xl border-b-2 border-transparent text-gray-400 hover:text-gray-200 flex items-center gap-2 transition-all">
        <i class="ti ti-history text-base text-amber-400"></i>
        <span>Activity Logs</span>
        <span id="inspectorLogCountBadge" class="px-1.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-[10px]">0</span>
      </button>
    </div>

    <!-- Content Area (Scrollable) -->
    <div class="p-6 overflow-y-auto flex-1 custom-scrollbar">
      <!-- Loading State -->
      <div id="inspectorLoading" class="py-12 flex flex-col items-center justify-center gap-3 text-gray-400">
        <div class="w-8 h-8 border-2 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
        <p class="text-xs font-medium">Loading user assets & logs...</p>
      </div>

      <!-- Tab Content: Videos -->
      <div id="inspectorTabVideos" class="hidden">
        <div id="inspectorVideoGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          <!-- Dynamically populated via JS -->
        </div>
        <div id="inspectorVideoEmpty" class="hidden py-12 text-center text-gray-400">
          <i class="ti ti-video-off text-4xl mb-2 block text-gray-500"></i>
          <p class="text-sm font-semibold text-white">No Media Files</p>
          <p class="text-xs text-gray-400 mt-1">This user has not uploaded any video files yet.</p>
        </div>
      </div>

      <!-- Tab Content: Streams -->
      <div id="inspectorTabStreams" class="hidden">
        <div id="inspectorStreamList" class="space-y-3">
          <!-- Dynamically populated via JS -->
        </div>
        <div id="inspectorStreamEmpty" class="hidden py-12 text-center text-gray-400">
          <i class="ti ti-broadcast-off text-4xl mb-2 block text-gray-500"></i>
          <p class="text-sm font-semibold text-white">No Streams Configured</p>
          <p class="text-xs text-gray-400 mt-1">This user has not created any stream channels yet.</p>
        </div>
      </div>

      <!-- Tab Content: Activity Logs (With Category Filters) -->
      <div id="inspectorTabLogs" class="hidden">
        <!-- Log Category Filter Pills -->
        <div class="flex items-center gap-2 mb-4 overflow-x-auto pb-1">
          <button type="button" onclick="filterLogCategory('all')" id="logFilterAll" 
            class="px-3 py-1 rounded-lg text-xs font-semibold bg-primary text-white transition-colors flex-shrink-0">
            All
          </button>
          <button type="button" onclick="filterLogCategory('auth')" id="logFilterAuth" 
            class="px-3 py-1 rounded-lg text-xs font-semibold bg-dark-800 text-gray-300 hover:text-white border border-[#27272a] transition-colors flex-shrink-0">
            Auth & Login
          </button>
          <button type="button" onclick="filterLogCategory('stream')" id="logFilterStream" 
            class="px-3 py-1 rounded-lg text-xs font-semibold bg-dark-800 text-gray-300 hover:text-white border border-[#27272a] transition-colors flex-shrink-0">
            Live Stream
          </button>
          <button type="button" onclick="filterLogCategory('media')" id="logFilterMedia" 
            class="px-3 py-1 rounded-lg text-xs font-semibold bg-dark-800 text-gray-300 hover:text-white border border-[#27272a] transition-colors flex-shrink-0">
            Media Files
          </button>
          <button type="button" onclick="filterLogCategory('admin')" id="logFilterAdmin" 
            class="px-3 py-1 rounded-lg text-xs font-semibold bg-dark-800 text-gray-300 hover:text-white border border-[#27272a] transition-colors flex-shrink-0">
            Admin Changes
          </button>
        </div>

        <div id="inspectorLogList" class="space-y-3">
          <!-- Dynamically populated via JS -->
        </div>
        <div id="inspectorLogEmpty" class="hidden py-12 text-center text-gray-400">
          <i class="ti ti-notes-off text-4xl mb-2 block text-gray-500"></i>
          <p class="text-sm font-semibold text-white">No Activity Logs Found</p>
          <p class="text-xs text-gray-400 mt-1">No recorded action history for this filter category.</p>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-3 border-t border-[#27272a] bg-dark-900/60 flex items-center justify-between flex-shrink-0">
      <span class="text-xs text-gray-400">Quick Peek Read-Only Mode</span>
      <button onclick="closeInspectorModal()" class="px-4 py-2 text-xs font-semibold bg-dark-800 hover:bg-dark-700 text-white rounded-xl border border-[#27272a] transition-colors">
        Close
      </button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL: USER DETAILS & SETTINGS (HIGH FIDELITY) -->
<!-- ========================================== -->
<div id="editModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200">
