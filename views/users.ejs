  // QUICK ASSET, STREAM & LOGS INSPECTOR LOGIC
  // ========================================================
  function formatBytes(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  function formatDuration(seconds) {
    if (!seconds) return '00:00';
    const hrs = Math.floor(seconds / 3600);
    const mins = Math.floor((seconds % 3600) / 60);
    const secs = Math.floor(seconds % 60);
    if (hrs > 0) {
      return `${hrs}:${mins < 10 ? '0' : ''}${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  function getActionCategoryStyle(category, actionType) {
    if (category === 'auth' || (actionType && actionType.startsWith('AUTH'))) {
      return { icon: 'ti-shield-lock', bg: 'bg-emerald-500/10', text: 'text-emerald-400', border: 'border-emerald-500/20', label: 'AUTH' };
    }
    if (category === 'admin' || (actionType && actionType.startsWith('USER'))) {
      return { icon: 'ti-user-cog', bg: 'bg-purple-500/10', text: 'text-purple-400', border: 'border-purple-500/20', label: 'ADMIN' };
    }
    if (category === 'stream' || (actionType && actionType.startsWith('STREAM'))) {
      return { icon: 'ti-broadcast', bg: 'bg-cyan-500/10', text: 'text-cyan-400', border: 'border-cyan-500/20', label: 'STREAM' };
    }
    if (category === 'media' || (actionType && actionType.startsWith('MEDIA'))) {
      return { icon: 'ti-video', bg: 'bg-blue-500/10', text: 'text-blue-400', border: 'border-blue-500/20', label: 'MEDIA' };
    }
    return { icon: 'ti-history', bg: 'bg-amber-500/10', text: 'text-amber-400', border: 'border-amber-500/20', label: 'GENERAL' };
  }

  function renderInspectorLogs() {
    const logList = document.getElementById('inspectorLogList');
    const logEmpty = document.getElementById('inspectorLogEmpty');
    logList.innerHTML = '';

    const filtered = currentLoadedInspectorLogs.filter(log => {
      if (currentActiveLogFilter === 'all') return true;
      const cat = (log.category || '').toLowerCase();
      const act = (log.action_type || '').toLowerCase();
      if (currentActiveLogFilter === 'auth') return cat === 'auth' || act.startsWith('auth') || act.includes('session');
      if (currentActiveLogFilter === 'stream') return cat === 'stream' || act.startsWith('stream') || cat === 'rotation' || act.startsWith('rotation');
      if (currentActiveLogFilter === 'media') return cat === 'media' || act.startsWith('media');
      if (currentActiveLogFilter === 'admin') return cat === 'admin' || act.startsWith('user_');
      return true;
    });

    if (filtered.length > 0) {
      logEmpty.classList.add('hidden');
      logList.classList.remove('hidden');
      filtered.forEach(log => {
        const style = getActionCategoryStyle(log.category, log.action_type);
        const isByAdmin = log.performed_by && log.performed_by !== currentActiveEditUsername;
        const parsedDate = parseDbDate(log.created_at);
        const relTime = formatRelativeTime(parsedDate);
        const fullTimeStr = parsedDate ? parsedDate.toLocaleString('en-GB', { timeZone: 'Asia/Jakarta', month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }) : '';

        const logItem = document.createElement('div');
        logItem.className = 'bg-dark-900 border border-[#27272a] rounded-xl p-3.5 flex items-start gap-3 hover:border-gray-600 transition-colors';
        logItem.innerHTML = `
          <div class="w-8 h-8 rounded-lg ${style.bg} ${style.text} border ${style.border} flex items-center justify-center text-sm flex-shrink-0 mt-0.5">
            <i class="ti ${style.icon}"></i>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded ${style.bg} ${style.text} border ${style.border}">
                  ${style.label}
                </span>
                ${isByAdmin ? `<span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 font-semibold">By ${log.performed_by}</span>` : ''}
              </div>
              <span class="text-[11px] text-gray-400 font-mono flex-shrink-0" title="${fullTimeStr}">
                ${relTime} <span class="text-gray-500 text-[10px]">(${fullTimeStr.split(' ')[3] || ''})</span>
              </span>
            </div>
            <p class="text-xs text-gray-200 mt-1.5 font-medium leading-relaxed break-words">
              ${log.description || log.action_type}
            </p>
            ${log.ip_address ? `
              <div class="mt-1.5 flex items-center gap-1 text-[10px] text-gray-500 font-mono">
                <i class="ti ti-map-pin text-[11px]"></i> IP: ${log.ip_address}
              </div>
            ` : ''}
          </div>
        `;
        logList.appendChild(logItem);
      });
    } else {
      logList.classList.add('hidden');
      logEmpty.classList.remove('hidden');
    }
  }

  function filterLogCategory(cat) {
    currentActiveLogFilter = cat;
    ['All', 'Auth', 'Stream', 'Media', 'Admin'].forEach(k => {
