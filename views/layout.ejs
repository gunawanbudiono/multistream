      <!-- Active Upload Warning Banner (Hidden by default) -->
      <div id="storageActiveUploadAlert" class="hidden p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl space-y-1 text-xs text-amber-300">
        <div class="flex items-center gap-2 font-bold text-amber-400">
          <i class="ti ti-alert-triangle text-base"></i>
          <span>Upload in Progress Detected</span>
        </div>
        <p class="text-[11px] text-amber-200/90 leading-relaxed">
          Active file chunks currently uploading are <strong>protected</strong> and will NOT be deleted by Clean Junk.
        </p>
        <ul id="storageActiveUploadFilesList" class="text-[10px] text-amber-300/80 font-mono mt-1 space-y-0.5 pl-1"></ul>
      </div>

      <!-- Breakdown List -->
      <div class="space-y-2 text-xs">
        <div class="flex items-center justify-between p-2.5 bg-dark-700/40 border border-gray-700/50 rounded-lg">
          <div class="flex items-center gap-2 text-gray-300">
            <i class="ti ti-package text-blue-400 text-sm"></i>
            <span>Docker Build Cache</span>
          </div>
          <span id="storageBuildCacheSize" class="font-mono font-semibold text-gray-200">--</span>
        </div>
        <div class="flex items-center justify-between p-2.5 bg-dark-700/40 border border-gray-700/50 rounded-lg">
          <div class="flex items-center gap-2 text-gray-300">
            <i class="ti ti-layers-linked text-purple-400 text-sm"></i>
            <span>Dangling Docker Layers</span>
          </div>
          <span id="storageDanglingSize" class="font-mono font-semibold text-gray-200">--</span>
        </div>
        <div class="border border-gray-700/50 rounded-lg overflow-hidden bg-dark-700/40">
          <div class="flex items-center justify-between p-2.5 cursor-pointer hover:bg-dark-700/70 transition-colors" onclick="toggleTempUploadsDetails()">
            <div class="flex items-center gap-2 text-gray-300">
              <i class="ti ti-clock-pause text-amber-400 text-sm"></i>
              <span class="font-medium">Temporary Upload Chunks</span>
              <span id="storageTempDetailsToggleBtn" class="text-[10px] px-1.5 py-0.2 rounded bg-dark-800 text-amber-300 border border-amber-500/30 flex items-center gap-0.5 hover:bg-dark-700">
                <span>View Details</span>
                <i class="ti ti-chevron-down text-xs transition-transform" id="storageTempDetailsChevron"></i>
              </span>
            </div>
            <span id="storageTempUploadsSize" class="font-mono font-semibold text-gray-200">--</span>
          </div>
          <!-- Expanded Details List -->
          <div id="storageTempUploadsDetails" class="hidden border-t border-gray-700/60 p-3 bg-dark-900/60 space-y-2">
            <div class="flex items-center justify-between text-[11px] text-gray-400 font-semibold mb-1">
              <span>Incomplete & Temp Files List:</span>
              <span id="storageTempSessionsCount" class="text-gray-500 text-[10px]">0 files</span>
            </div>
            <div id="storageTempSessionsList" class="space-y-2 max-h-48 overflow-y-auto pr-1">
              <!-- Dynamically populated -->
            </div>
          </div>
        </div>
      </div>

      <!-- Status Summary Text -->
      <p id="storageScanSummaryText" class="text-xs text-gray-400 italic text-center min-h-[18px]">
        Ready to scan system storage.
      </p>

      <!-- Safety Notice -->
      <div class="p-2.5 bg-emerald-950/30 border border-emerald-800/40 rounded-lg flex items-start gap-2 text-[11px] text-emerald-300">
        <i class="ti ti-shield-check text-emerald-400 text-sm mt-0.5 shrink-0"></i>
        <span><strong>100% Safe:</strong> This action never deletes user media files, stream configs, or database records.</span>
      </div>
    </div>

    <!-- Footer Actions -->
    <div class="px-6 py-4 border-t border-gray-700 bg-dark-800/80 flex items-center justify-end gap-2.5">
      <button type="button" onclick="closeStorageCleanerModal()" class="px-4 py-2 bg-dark-700 hover:bg-dark-600 text-gray-300 rounded-lg text-xs font-semibold transition-colors">
        Close
      </button>
      <button type="button" id="storageCleanBtn" onclick="cleanStorageJunk()" 
        class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-black font-bold rounded-lg text-xs flex items-center gap-1.5 transition-all shadow-md disabled:opacity-50 disabled:cursor-not-allowed">
        <i class="ti ti-loader animate-spin hidden text-sm" id="storageCleanSpinner"></i>
        <i class="ti ti-bolt text-sm" id="storageCleanBtnIcon"></i>
        <span id="storageCleanBtnText">Clean Junk Now</span>
      </button>
    </div>
  </div>
</div>
<% } %>
