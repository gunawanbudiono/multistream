  // ==========================================
  // GLOBAL CUSTOM CONFIRMATION MODAL
  // ==========================================
  window.showCustomConfirm = function(title, message, onConfirm, options = {}) {
    const modal = document.getElementById('globalConfirmModal');
    const content = document.getElementById('globalConfirmModalContent');
    const titleEl = document.getElementById('globalConfirmTitle');
    const msgEl = document.getElementById('globalConfirmMessage');
    const cancelBtn = document.getElementById('globalConfirmCancelBtn');
    const okBtn = document.getElementById('globalConfirmOkBtn');
    const iconEl = document.getElementById('globalConfirmIcon');

    if (!modal || !content) return;

    if (titleEl) titleEl.innerText = title || 'Confirm Action';
    if (msgEl) msgEl.innerText = message || 'Are you sure you want to proceed?';
    if (okBtn) {
      okBtn.innerText = options.okText || 'Confirm';
      okBtn.className = `px-5 py-2 text-sm font-medium rounded-xl transition-colors ${options.okClass || 'bg-primary hover:bg-blue-600 text-white'}`;
    }
    if (iconEl && options.icon) {
      iconEl.className = `ti ${options.icon}`;
    }

    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      content.classList.remove('opacity-0', 'scale-95');
    }, 10);

    const cleanup = () => {
      modal.classList.add('opacity-0');
      content.classList.add('opacity-0', 'scale-95');
      setTimeout(() => modal.classList.add('hidden'), 200);
    };

    cancelBtn.onclick = cleanup;
    okBtn.onclick = () => {
      cleanup();
      if (typeof onConfirm === 'function') onConfirm();
    };
  };

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const gModal = document.getElementById('globalConfirmModal');
      if (gModal && !gModal.classList.contains('hidden')) {
        document.getElementById('globalConfirmCancelBtn')?.click();
      }
    }
  });

  <% if (req.session && req.session.user_role === 'admin') { %>
  let activeUploadPollTimer = null;
  
  function formatBytesReadable(bytes) {
    if (!bytes || bytes <= 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  let activeUploadState = null;
  let activeUploadTickerTimer = null;

  function formatEtaDurationReadable(seconds) {
    if (!seconds || seconds <= 0) return '--';
    if (seconds >= 3600) {
      const h = Math.floor(seconds / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      const s = seconds % 60;
      return `${h}j ${m}m ${s}s`;
    }
    if (seconds >= 60) {
      const m = Math.floor(seconds / 60);
      const s = seconds % 60;
      return `${m}m ${s}s`;
    }
    return `${seconds}s`;
  }

  function tickActiveUploadBadge() {
    if (!activeUploadState || !activeUploadState.active) {
      if (activeUploadTickerTimer) {
        clearInterval(activeUploadTickerTimer);
        activeUploadTickerTimer = null;
      }
      return;
    }

    const text = document.getElementById('globalActiveUploadBadgeText');
    if (!text) return;

    const now = Date.now();
    const elapsedSec = (now - activeUploadState.lastUpdated) / 1000;
    const top = activeUploadState.top;

    if (top) {
      const currentEtaSec = Math.max(0, (top.etaSeconds || 0) - Math.floor(elapsedSec));
      const etaStr = formatEtaDurationReadable(currentEtaSec);
      const uploadedStr = formatBytesReadable(top.uploadedBytes);
      const totalStr = formatBytesReadable(top.fileSize);
      const speedPart = (top.speedFormatted && top.speedFormatted !== '0 KB/s') ? ` • ⚡ ${top.speedFormatted}` : '';
      const etaPart = (etaStr && etaStr !== '--') ? ` • ⏱️ ${etaStr}` : '';
      text.innerText = `1 Upload Active • ${uploadedStr} / ${totalStr} (${top.progress}%)${speedPart}${etaPart}`;
    }
  }

  async function pollActiveUploads() {
    try {
      const res = await fetch('/api/system/active-uploads');
      const data = await res.json();
      const badge = document.getElementById('globalActiveUploadBadge');
      const text = document.getElementById('globalActiveUploadBadgeText');
      const sep = document.getElementById('globalActiveUploadSeparator');

      if (data.success && data.activeUploads && data.activeUploads.length > 0) {
        const uploads = data.activeUploads;
        const count = uploads.length;
        let label = '';

        if (count === 1) {
          const top = uploads[0];
          activeUploadState = {
            active: true,
            top,
            lastUpdated: Date.now()
          };
          const uploadedStr = formatBytesReadable(top.uploadedBytes);
          const totalStr = formatBytesReadable(top.fileSize);
          const speedPart = (top.speedFormatted && top.speedFormatted !== '0 KB/s') ? ` • ⚡ ${top.speedFormatted}` : '';
          const etaPart = (top.etaFormatted && top.etaFormatted !== '--') ? ` • ⏱️ ${top.etaFormatted}` : '';
          label = `1 Upload Active • ${uploadedStr} / ${totalStr} (${top.progress}%)${speedPart}${etaPart}`;
          
          // Start 1-second countdown ticker for smooth UI
          if (!activeUploadTickerTimer) {
            activeUploadTickerTimer = setInterval(tickActiveUploadBadge, 1000);
          }
        } else {
          activeUploadState = null;
          const totalUploaded = uploads.reduce((acc, u) => acc + (u.uploadedBytes || 0), 0);
          const totalSize = uploads.reduce((acc, u) => acc + (u.fileSize || 0), 0);
          const totalProgress = totalSize > 0 ? ((totalUploaded / totalSize) * 100).toFixed(1) : 0;
          const uploadedStr = formatBytesReadable(totalUploaded);
          const totalStr = formatBytesReadable(totalSize);
          label = `${count} Uploads Active • Total ${uploadedStr} / ${totalStr} (${totalProgress}%)`;
        }
        
        if (text) text.innerText = label;
        if (badge) {
          badge.classList.remove('hidden');
          badge.classList.add('flex');
          badge.onclick = () => {
            openStorageCleanerModal();
          };
        }
        if (sep) sep.classList.remove('hidden');

        // Adaptive polling: 3s while active uploads are running
        if (activeUploadPollTimer) clearTimeout(activeUploadPollTimer);
        activeUploadPollTimer = setTimeout(pollActiveUploads, 3000);
      } else {
        activeUploadState = null;
        if (activeUploadTickerTimer) {
          clearInterval(activeUploadTickerTimer);
          activeUploadTickerTimer = null;
        }
        if (badge) {
          badge.classList.add('hidden');
          badge.classList.remove('flex');
        }
        if (sep) sep.classList.add('hidden');

        // Idle polling every 8s
        if (activeUploadPollTimer) clearTimeout(activeUploadPollTimer);
        activeUploadPollTimer = setTimeout(pollActiveUploads, 8000);
      }
    } catch (e) {
      if (activeUploadPollTimer) clearTimeout(activeUploadPollTimer);
      activeUploadPollTimer = setTimeout(pollActiveUploads, 10000);
    }
  }

  // Initialize polling after DOM loads
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(pollActiveUploads, 1500);
    });
  } else {
    setTimeout(pollActiveUploads, 1500);
  }

  // ==========================================
  // GLOBAL STORAGE OPTIMIZER & JUNK CLEANER (ADMIN ONLY)
  // ==========================================
  function openStorageCleanerModal() {
    const modal = document.getElementById('storageCleanerModal');
    if (!modal) return;
    document.body.style.overflow = 'hidden';
    modal.classList.remove('hidden');
    requestAnimationFrame(() => modal.classList.add('active'));
    scanStorageJunk();
  }

  function closeStorageCleanerModal() {
    const modal = document.getElementById('storageCleanerModal');
    if (!modal) return;
    modal.classList.remove('active');
    setTimeout(() => modal.classList.add('hidden'), 200);
    document.body.style.overflow = 'auto';
  }

  function toggleTempUploadsDetails() {
    const el = document.getElementById('storageTempUploadsDetails');
    const chevron = document.getElementById('storageTempDetailsChevron');
    if (!el) return;
    el.classList.toggle('hidden');
    if (chevron) {
      if (el.classList.contains('hidden')) {
        chevron.style.transform = 'rotate(0deg)';
      } else {
        chevron.style.transform = 'rotate(180deg)';
      }
    }
  }

  async function purgeUploadSession(uploadId) {
    if (typeof showCustomConfirm === 'function') {
      showCustomConfirm(
        'Purge Upload Session',
        'Are you sure you want to delete this incomplete upload session and free up its temporary chunks?',
        async () => {
          try {
            const res = await fetch(`/api/system/storage-purge-session/${uploadId}`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
              if (typeof showToast === 'function') showToast('success', 'Upload session purged successfully');
              scanStorageJunk();
            } else {
              if (typeof showToast === 'function') showToast('error', data.error || 'Failed to purge upload session');
            }
          } catch (e) {
            if (typeof showToast === 'function') showToast('error', e.message);
          }
        },
        {
          icon: 'ti-trash',
          okText: 'Purge File',
          okClass: 'bg-red-500 hover:bg-red-600 text-white'
        }
      );
    }
  }

  async function scanStorageJunk() {
    const scanBtn = document.getElementById('storageScanBtn');
    const cleanBtn = document.getElementById('storageCleanBtn');
    const scanSpinner = document.getElementById('storageScanSpinner');
    const totalReclaimEl = document.getElementById('storageTotalReclaimable');
    const buildCacheEl = document.getElementById('storageBuildCacheSize');
    const danglingEl = document.getElementById('storageDanglingSize');
    const tempUploadsEl = document.getElementById('storageTempUploadsSize');
    const scanSummaryText = document.getElementById('storageScanSummaryText');

    if (scanBtn) scanBtn.disabled = true;
    if (cleanBtn) cleanBtn.disabled = true;
    if (scanSpinner) scanSpinner.classList.remove('hidden');
    if (scanSummaryText) scanSummaryText.innerText = 'Scanning system layers, Docker build cache, and temp files...';

    try {
      const res = await fetch('/api/system/storage-audit');
      const data = await res.json();

      if (!data.success) throw new Error(data.error || 'Failed to scan storage');

      const d = data.data;
      const total = d.totalReclaimableBytes || 0;
      
      if (totalReclaimEl) totalReclaimEl.innerText = formatBytesReadable(total);
      if (buildCacheEl) buildCacheEl.innerText = formatBytesReadable(d.buildCache?.reclaimableBytes || d.buildCache?.totalBytes);
      if (danglingEl) danglingEl.innerText = formatBytesReadable(d.danglingImages?.totalBytes);
      
      const activeUploads = d.activeUploads || { count: 0, totalBytes: 0, files: [] };
      const activeAlert = document.getElementById('storageActiveUploadAlert');
      const activeFilesList = document.getElementById('storageActiveUploadFilesList');

      if (activeUploads.count > 0) {
        if (activeAlert) activeAlert.classList.remove('hidden');
        if (activeFilesList) {
          activeFilesList.innerHTML = activeUploads.files.map(f => `<li>• <strong>${f.filename}</strong> (${formatBytesReadable(f.fileSize)})</li>`).join('');
        }
        if (tempUploadsEl) {
          tempUploadsEl.innerHTML = `<span class="text-amber-400 font-semibold">${formatBytesReadable(d.tempUploads?.activeBytes || 0)} (Active In-Use)</span>`;
        }
      } else {
        if (activeAlert) activeAlert.classList.add('hidden');
        if (tempUploadsEl) {
          tempUploadsEl.innerText = `${formatBytesReadable(d.tempUploads?.totalBytes || 0)} (${d.tempUploads?.fileCount || 0} files)`;
        }
      }

      // Render Detailed Temporary Sessions
      const sessions = d.tempUploads?.sessions || [];
      const sessionsListEl = document.getElementById('storageTempSessionsList');
      const sessionsCountEl = document.getElementById('storageTempSessionsCount');
      if (sessionsCountEl) sessionsCountEl.innerText = `${sessions.length} file session(s)`;

      if (sessionsListEl) {
        if (sessions.length === 0) {
          sessionsListEl.innerHTML = `<div class="p-3 text-center text-gray-500 italic text-[11px]">No temporary chunks or incomplete uploads found.</div>`;
        } else {
          sessionsListEl.innerHTML = sessions.map(s => {
            const statusBadge = s.isActive
              ? `<span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[9px] font-bold uppercase tracking-wider flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Active</span>`
              : `<span class="px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30 text-[9px] font-semibold flex items-center gap-1"><i class="ti ti-clock-pause"></i> Incomplete</span>`;
            
            const uploadedStr = formatBytesReadable(s.uploadedBytes);
            const totalStr = formatBytesReadable(s.fileSize);
            
            return `
              <div class="bg-dark-800 border border-gray-700/80 rounded-lg p-2.5 text-xs space-y-1.5">
                <div class="flex items-center justify-between gap-2">
                  <div class="font-bold text-gray-200 truncate flex items-center gap-1.5 min-w-0" title="${s.filename}">
                    <i class="ti ti-video text-primary text-sm shrink-0"></i>
                    <span class="truncate">${s.filename}</span>
                  </div>
                  <div class="shrink-0 flex items-center gap-1.5">
                    ${statusBadge}
                    ${!s.isActive ? `
                      <button type="button" onclick="purgeUploadSession('${s.uploadId}')" class="p-1 rounded hover:bg-red-500/20 text-red-400 border border-transparent hover:border-red-500/30 transition-colors" title="Purge this file">
                        <i class="ti ti-trash text-xs"></i>
                      </button>
                    ` : ''}
                  </div>
                </div>
                <div class="flex items-center justify-between text-[10px] text-gray-400 font-mono">
                  <span>User: <strong class="text-gray-300 font-sans">${s.username || 'User'}</strong></span>
                  <span>${s.uploadedChunksCount} / ${s.totalChunks} Chunks • ${uploadedStr} / ${totalStr} (${s.progress}%)</span>
                </div>
                ${s.isActive && s.speedFormatted && s.speedFormatted !== '0 KB/s' ? `
                  <div class="flex items-center justify-between text-[10px] text-emerald-400 font-mono bg-emerald-950/40 px-2 py-0.5 rounded border border-emerald-800/30">
                    <span>⚡ Speed: <strong>${s.speedFormatted}</strong></span>
                    <span>⏱️ ETA: <strong>${s.etaFormatted}</strong></span>
                  </div>
                ` : ''}
                <div class="w-full bg-gray-700 rounded-full h-1.5 overflow-hidden">
                  <div class="${s.isActive ? 'bg-emerald-500' : 'bg-amber-500'} h-1.5 rounded-full transition-all duration-300" style="width: ${s.progress}%"></div>
                </div>
              </div>
            `;
          }).join('');
        }
      }
      
      if (scanSummaryText) {
        if (activeUploads.count > 0 && total > 0) {
          scanSummaryText.innerHTML = `<span class="text-amber-300">⚠️ Active upload detected. Upload files are safely protected. Found ${formatBytesReadable(total)} reclaimable cache.</span>`;
          if (cleanBtn) cleanBtn.disabled = false;
        } else if (activeUploads.count > 0 && total === 0) {
          scanSummaryText.innerHTML = `<span class="text-amber-300">⚠️ Active upload in progress & protected. No reclaimable junk found (0 MB).</span>`;
          if (cleanBtn) cleanBtn.disabled = true;
        } else if (total > 0) {
          scanSummaryText.innerText = `Scan complete. Found ${formatBytesReadable(total)} of reclaimable system junk.`;
          if (cleanBtn) cleanBtn.disabled = false;
        } else {
          scanSummaryText.innerText = 'System is 100% clean and optimal! No junk files found.';
          if (cleanBtn) cleanBtn.disabled = true;
        }
      }
    } catch (err) {
      console.error('Scan storage error:', err);
      if (scanSummaryText) scanSummaryText.innerText = 'Error scanning storage: ' + err.message;
    } finally {
      if (scanBtn) scanBtn.disabled = false;
      if (scanSpinner) scanSpinner.classList.add('hidden');
    }
  };

  window.cleanStorageJunk = async function() {
    const cleanBtn = document.getElementById('storageCleanBtn');
    const scanBtn = document.getElementById('storageScanBtn');
    const cleanSpinner = document.getElementById('storageCleanSpinner');
    const cleanBtnText = document.getElementById('storageCleanBtnText');
    const cleanBtnIcon = document.getElementById('storageCleanBtnIcon');
    const scanSummaryText = document.getElementById('storageScanSummaryText');

    if (cleanBtn) cleanBtn.disabled = true;
    if (scanBtn) scanBtn.disabled = true;
    if (cleanSpinner) cleanSpinner.classList.remove('hidden');
    if (cleanBtnIcon) cleanBtnIcon.classList.add('hidden');
    if (cleanBtnText) cleanBtnText.innerText = 'Cleaning Junk...';
    if (scanSummaryText) scanSummaryText.innerText = 'Purging Docker build cache and cleaning temporary files...';

    try {
      const res = await fetch('/api/system/storage-clean', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const data = await res.json();

      if (!data.success) throw new Error(data.error || 'Failed to clean storage');

      const reclaimed = formatBytesReadable(data.reclaimedBytes);
      if (scanSummaryText) scanSummaryText.innerText = `Success! Cleaned and reclaimed ${reclaimed} of storage.`;
      
      if (typeof showToast === 'function') {
        showToast('success', `Successfully cleaned ${reclaimed} of system junk!`);
      }

      // Re-scan to show updated size
      setTimeout(() => {
        scanStorageJunk();
        if (typeof fetchSystemStats === 'function') fetchSystemStats();
      }, 1200);

    } catch (err) {
      console.error('Clean storage error:', err);
      if (scanSummaryText) scanSummaryText.innerText = 'Error cleaning storage: ' + err.message;
      if (typeof showToast === 'function') {
        showToast('error', 'Error cleaning storage: ' + err.message);
      }
    } finally {
      if (cleanBtn) cleanBtn.disabled = false;
      if (scanBtn) scanBtn.disabled = false;
      if (cleanSpinner) cleanSpinner.classList.add('hidden');
      if (cleanBtnIcon) cleanBtnIcon.classList.remove('hidden');
      if (cleanBtnText) cleanBtnText.innerText = 'Clean Junk Now';
    }
  };
  <% } %>
</script>

